<% content_for :title, "Подтвердите email — Lavkin" %>

<div class="flex min-h-screen items-center justify-center bg-[#f7f7f7] px-5 py-12">

  <div class="w-full max-w-md">

    <div class="
      rounded-3xl
      border border-black/10
      bg-white
      p-7
      shadow-sm
      sm:p-8
    ">

      <div class="
        flex size-12
        items-center justify-center
        rounded-2xl
        bg-[#303030]
        text-lg font-black
        text-white
      ">
        L
      </div>


      <h1 class="
        mt-6
        text-3xl font-black
        tracking-[-0.05em]
      ">
        Подтвердите email
      </h1>


      <p class="
        mt-3
        text-sm leading-6
        text-[#616161]
      ">
        Мы отправили письмо с подтверждением
        <% if @email.present? %>
          на
          <strong class="text-[#303030]">
            <%= @email %>
          </strong>.
        <% else %>
          на ваш email.
        <% end %>
      </p>


      <div class="
        mt-6
        rounded-2xl
        border border-black/10
        bg-[#f7f7f7]
        p-4
      ">

        <div class="flex gap-3">

          <svg
            class="mt-0.5 size-5 shrink-0 text-[#008060]"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <rect x="3" y="5" width="18" height="14" rx="2"/>
            <path d="m3 7 9 6 9-6"/>
          </svg>


          <div>

            <p class="text-sm font-black">
              Проверьте почту
            </p>

            <p class="
              mt-1
              text-xs leading-5
              text-[#8a8a8a]
            ">
              Откройте письмо от Lavkin и нажмите
              «Подтвердить email».
            </p>

          </div>

        </div>

      </div>


      <% if notice.present? %>

        <div class="
          mt-5
          rounded-xl
          border border-green-200
          bg-green-50
          px-4 py-3
          text-sm font-bold
          text-green-700
        ">
          <%= notice %>
        </div>

      <% end %>


      <% if alert.present? %>

        <div class="
          mt-5
          rounded-xl
          border border-red-200
          bg-red-50
          px-4 py-3
          text-sm font-bold
          text-red-700
        ">
          <%= alert %>
        </div>

      <% end %>


      <%= button_to "Отправить письмо повторно",
                    resend_email_verification_path,
                    method: :post,
                    class: "
                      mt-6
                      h-11 w-full
                      cursor-pointer
                      rounded-xl
                      bg-[#303030]
                      px-4
                      text-sm font-black
                      text-white
                      transition
                      hover:bg-black
                    " %>


      <%= link_to "Вернуться ко входу",
                  new_session_path,
                  class: "
                    mt-3
                    flex h-11 w-full
                    items-center justify-center
                    rounded-xl
                    border border-black/10
                    bg-white
                    px-4
                    text-sm font-black
                    transition
                    hover:bg-[#f7f7f7]
                  " %>


      <p class="
        mt-6
        text-center
        text-xs leading-5
        text-[#8a8a8a]
      ">
        Если письма нет, проверьте папку «Спам».
      </p>

    </div>

  </div>

</div>