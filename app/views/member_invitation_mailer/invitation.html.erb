<!DOCTYPE html>

<html lang="ru">

<head>
  <meta charset="UTF-8">

  <meta
    name="viewport"
    content="width=device-width, initial-scale=1"
  >
</head>

<body style="
  margin: 0;
  padding: 0;
  background: #f5f5f5;
  font-family: Arial, sans-serif;
  color: #303030;
">

  <table
    width="100%"
    cellpadding="0"
    cellspacing="0"
    role="presentation"
  >
    <tr>
      <td
        align="center"
        style="padding: 40px 20px;"
      >

        <table
          width="100%"
          cellpadding="0"
          cellspacing="0"
          role="presentation"
          style="
            max-width: 560px;
            background: #ffffff;
            border-radius: 16px;
            overflow: hidden;
          "
        >

          <tr>
            <td style="padding: 32px;">

              <div style="
                font-size: 22px;
                font-weight: 800;
                margin-bottom: 28px;
              ">
                Lavkin
              </div>


              <h1 style="
                margin: 0;
                font-size: 26px;
                line-height: 1.25;
              ">
                Вас пригласили в команду
              </h1>


              <p style="
                margin: 18px 0 0;
                font-size: 16px;
                line-height: 1.6;
                color: #616161;
              ">
                Вы получили приглашение присоединиться
                к бизнесу
                <strong>
                  <%= @account.name %>
                </strong>
                в Lavkin.
              </p>


              <p style="
                margin: 16px 0 0;
                font-size: 15px;
                line-height: 1.6;
                color: #616161;
              ">
                Роль:
                <strong>
                  <%= @invitation.role %>
                </strong>
              </p>


              <div style="margin-top: 28px;">

                <%= link_to "Принять приглашение",
                    @accept_url,
                    style: "
                      display: inline-block;
                      padding: 14px 22px;
                      background: #303030;
                      color: #ffffff;
                      text-decoration: none;
                      border-radius: 10px;
                      font-size: 14px;
                      font-weight: 700;
                    " %>

              </div>


              <p style="
                margin: 28px 0 0;
                font-size: 13px;
                line-height: 1.6;
                color: #8a8a8a;
              ">
                Ссылка действует до
                <%= l(
                      @invitation.expires_at,
                      format: :long
                    ) %>.
              </p>

            </td>
          </tr>

        </table>

      </td>
    </tr>
  </table>

</body>

</html>