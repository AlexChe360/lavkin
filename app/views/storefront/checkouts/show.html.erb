<% content_for :title, "Оформление заказа — #{@shop.name}" %>

<div class="min-h-screen">

  <!-- HEADER -->

  <header class="border-b border-black/10 bg-white">

    <div class="mx-auto flex h-16 max-w-[1200px] items-center justify-between px-5 sm:px-6 lg:px-8">

      <%= link_to storefront_root_path(
                    shop_slug: @shop.slug
                  ),
                  class: "text-lg font-black" do %>

        <%= @shop.name %>

      <% end %>


      <span class="text-sm font-bold text-[#616161]">
        Оформление заказа
      </span>

    </div>

  </header>


  <!-- CONTENT -->

  <main class="mx-auto max-w-[1100px] px-5 py-8 sm:px-6 lg:px-8">

    <%= link_to "← Корзина",
                storefront_cart_path(
                  shop_slug: @shop.slug
                ),
                class: "text-sm font-bold text-[#616161] hover:text-black" %>


    <h1 class="mt-5 text-3xl font-black tracking-[-0.05em]">
      Оформление заказа
    </h1>


    <%= form_with url: storefront_checkout_path(
                    shop_slug: @shop.slug
                  ),
                  method: :post,
                  scope: :checkout,
                  class: "mt-7 grid gap-6 lg:grid-cols-[1fr_360px]" do |form| %>


      <!-- LEFT -->

      <div class="space-y-5">

        <% if @error_message.present? %>

          <div class="rounded-xl border border-red-200 bg-red-50 p-4 text-sm font-bold text-red-700">
            <%= @error_message %>
          </div>

        <% end %>


        <!-- CONTACTS -->

        <section class="rounded-2xl border border-black/10 bg-white p-6">

          <h2 class="font-black">
            Контактные данные
          </h2>

          <p class="mt-1 text-sm text-[#8a8a8a]">
            Данные нужны для связи по заказу.
          </p>


          <div class="mt-6 space-y-5">

            <!-- NAME -->

            <div>

              <%= form.label :customer_name,
                             "Имя",
                             class: "block text-sm font-black" %>

              <%= form.text_field :customer_name,
                                  required: true,
                                  autocomplete: "name",
                                  placeholder: "Алексей",
                                  class: "
                                    mt-2 h-11 w-full
                                    rounded-xl border border-black/10
                                    bg-white px-4 text-sm
                                    outline-none
                                    focus:border-[#008060]
                                  " %>

            </div>


            <!-- PHONE -->

            <div>

              <%= form.label :customer_phone,
                             "Телефон",
                             class: "block text-sm font-black" %>

              <%= form.telephone_field :customer_phone,
                                       required: true,
                                       autocomplete: "tel",
                                       placeholder: "+7 (___) ___-__-__",
                                       data: {
                                         controller: "phone-mask",
                                         action: "input->phone-mask#format"
                                       },
                                       class: "
                                         mt-2 h-11 w-full
                                         rounded-xl border border-black/10
                                         bg-white px-4 text-sm
                                         outline-none
                                         focus:border-[#008060]
                                       " %>

            </div>


            <!-- EMAIL -->

            <div>

              <%= form.label :customer_email,
                             "Email",
                             class: "block text-sm font-black" %>

              <%= form.email_field :customer_email,
                                   autocomplete: "email",
                                   placeholder: "email@example.com",
                                   class: "
                                     mt-2 h-11 w-full
                                     rounded-xl border border-black/10
                                     bg-white px-4 text-sm
                                     outline-none
                                     focus:border-[#008060]
                                   " %>

            </div>

          </div>

        </section>


        <!-- FULFILLMENT -->

        <section
          data-controller="delivery"
          class="rounded-2xl border border-black/10 bg-white p-6"
        >

          <h2 class="font-black">
            Получение
          </h2>

          <p class="mt-1 text-sm text-[#8a8a8a]">
            Выберите удобный способ получения заказа.
          </p>


          <div class="mt-6 space-y-3">

            <!-- PICKUP -->

            <% if @shop.storefront_pickup_enabled? %>

              <label class="
                flex cursor-pointer items-start gap-3
                rounded-xl border border-black/10
                p-4
                transition
                hover:bg-[#fafafa]
              ">

                <%= form.radio_button :fulfillment_type,
                                      "pickup",
                                      checked: !@shop.storefront_delivery_enabled?,
                                      data: {
                                        action: "change->delivery#toggle"
                                      },
                                      class: "mt-1 size-4" %>


                <div>

                  <p class="text-sm font-black">
                    Самовывоз
                  </p>

                  <p class="mt-1 text-xs text-[#8a8a8a]">
                    Заберите заказ самостоятельно.
                  </p>

                  <p class="mt-3 text-sm font-bold text-[#303030]">
                    <%= @shop.name %>
                  </p>

                </div>

              </label>

            <% end %>


            <!-- DELIVERY -->

            <% if @shop.storefront_delivery_enabled? %>

              <label class="
                flex cursor-pointer items-start gap-3
                rounded-xl border border-black/10
                p-4
                transition
                hover:bg-[#fafafa]
              ">

                <%= form.radio_button :fulfillment_type,
                                      "delivery",
                                      checked: !@shop.storefront_pickup_enabled?,
                                      data: {
                                        action: "change->delivery#toggle"
                                      },
                                      class: "mt-1 size-4" %>


                <div>

                  <p class="text-sm font-black">
                    Доставка
                  </p>

                  <p class="mt-1 text-xs text-[#8a8a8a]">
                    Доставим заказ по указанному адресу.
                  </p>

                </div>

              </label>

            <% end %>

          </div>


          <!-- DELIVERY ADDRESS -->

          <% if @shop.storefront_delivery_enabled? %>

            <div
              data-delivery-target="address"
              class="
                mt-6 hidden
                border-t border-black/10
                pt-6
              "
            >

              <h3 class="text-sm font-black">
                Адрес доставки
              </h3>


              <div class="mt-5 grid gap-4 sm:grid-cols-2">

                <!-- STREET -->

                <div class="sm:col-span-2">

                  <%= form.label :delivery_street,
                                 "Улица",
                                 class: "block text-sm font-black" %>

                  <%= form.text_field :delivery_street,
                                      placeholder: "ул. Абая",
                                      autocomplete: "street-address",
                                      data: {
                                        delivery_target: "field"
                                      },
                                      class: "
                                        mt-2 h-11 w-full
                                        rounded-xl border border-black/10
                                        bg-white px-4 text-sm
                                        outline-none
                                        focus:border-[#008060]
                                      " %>

                </div>


                <!-- HOUSE -->

                <div>

                  <%= form.label :delivery_house,
                                 "Дом",
                                 class: "block text-sm font-black" %>

                  <%= form.text_field :delivery_house,
                                      placeholder: "150",
                                      data: {
                                        delivery_target: "field"
                                      },
                                      class: "
                                        mt-2 h-11 w-full
                                        rounded-xl border border-black/10
                                        bg-white px-4 text-sm
                                        outline-none
                                        focus:border-[#008060]
                                      " %>

                </div>


                <!-- APARTMENT -->

                <div>

                  <%= form.label :delivery_apartment,
                                 "Квартира / офис",
                                 class: "block text-sm font-black" %>

                  <%= form.text_field :delivery_apartment,
                                      placeholder: "24",
                                      data: {
                                        delivery_target: "field"
                                      },
                                      class: "
                                        mt-2 h-11 w-full
                                        rounded-xl border border-black/10
                                        bg-white px-4 text-sm
                                        outline-none
                                        focus:border-[#008060]
                                      " %>

                </div>


                <!-- COMMENT -->

                <div class="sm:col-span-2">

                  <%= form.label :delivery_comment,
                                 "Комментарий курьеру",
                                 class: "block text-sm font-black" %>

                  <%= form.text_area :delivery_comment,
                                     rows: 3,
                                     placeholder: "Подъезд, этаж, домофон или другие детали",
                                     data: {
                                       delivery_target: "field"
                                     },
                                     class: "
                                       mt-2 w-full resize-none
                                       rounded-xl border border-black/10
                                       bg-white px-4 py-3 text-sm
                                       outline-none
                                       focus:border-[#008060]
                                     " %>

                </div>

              </div>

            </div>

          <% end %>

        </section>

      </div>


      <!-- RIGHT -->

      <aside>

        <div class="sticky top-6 rounded-2xl border border-black/10 bg-white p-5">

          <h2 class="font-black">
            Ваш заказ
          </h2>


          <!-- ITEMS -->

          <div class="mt-5 divide-y divide-black/10">

            <% @cart_items.each do |item| %>

              <div class="flex gap-3 py-4 first:pt-0">

                <% if item.product.image.attached? %>

                  <%= image_tag item.product.image,
                                class: "
                                  size-14 shrink-0
                                  rounded-lg
                                  border border-black/10
                                  object-contain p-1
                                " %>

                <% end %>


                <div class="min-w-0 flex-1">

                  <p class="truncate text-sm font-black">
                    <%= item.product.name %>
                  </p>

                  <p class="mt-1 text-xs text-[#8a8a8a]">

                    <%= item.quantity %> ×

                    <%= number_to_currency(
                          item.product.price,
                          unit: "₸",
                          format: "%n %u",
                          delimiter: " ",
                          separator: ","
                        ) %>

                  </p>

                </div>


                <p class="whitespace-nowrap text-sm font-black">

                  <%= number_to_currency(
                        item.product.price * item.quantity,
                        unit: "₸",
                        format: "%n %u",
                        delimiter: " ",
                        separator: ","
                      ) %>

                </p>

              </div>

            <% end %>

          </div>


          <!-- TOTAL -->

          <div class="
            mt-4 flex items-center justify-between
            border-t border-black/10
            pt-4
          ">

            <span class="font-black">
              Итого
            </span>

            <span class="text-xl font-black">

              <%= number_to_currency(
                    @cart.total_price,
                    unit: "₸",
                    format: "%n %u",
                    delimiter: " ",
                    separator: ","
                  ) %>

            </span>

          </div>


          <!-- SUBMIT -->

          <%= form.submit "Перейти к оплате",
                          class: "
                            mt-6 h-12 w-full
                            cursor-pointer
                            rounded-xl bg-[#303030]
                            px-5 text-sm font-black text-white
                            transition hover:bg-black
                          " %>


          <p class="mt-3 text-center text-xs leading-5 text-[#8a8a8a]">
            На следующем шаге будет выполнен переход к оплате.
          </p>

        </div>

      </aside>

    <% end %>

  </main>

</div>