<% content_for :title, "Заказ #{@order.number} — #{@shop.name}" %>

<div class="min-h-screen bg-[#f7f7f7]">

  <main class="mx-auto max-w-[700px] px-5 py-16 sm:px-6">

    <div class="rounded-3xl border border-black/10 bg-white p-7">

      <div class="flex size-12 items-center justify-center rounded-full bg-[#e3f1df] text-xl font-black text-[#008060]">
        ✓
      </div>

      <p class="mt-6 text-sm font-black text-[#008060]">
        Заказ создан
      </p>

      <h1 class="mt-2 text-3xl font-black tracking-[-0.05em]">
        <%= @order.number %>
      </h1>

      <p class="mt-3 text-sm leading-6 text-[#616161]">
        Заказ ожидает оплату.
      </p>


      <div class="mt-7 divide-y divide-black/10 border-y border-black/10">

        <% @order.order_items.each do |item| %>

          <div class="flex items-center justify-between gap-4 py-4">

            <div>

              <p class="text-sm font-black">
                <%= item.product_name %>
              </p>

              <p class="mt-1 text-xs text-[#8a8a8a]">
                <%= item.quantity %> ×
                <%= number_to_currency(
                      item.price,
                      unit: "₸",
                      format: "%n %u",
                      delimiter: " ",
                      separator: ","
                    ) %>
              </p>

            </div>


            <p class="font-black">
              <%= number_to_currency(
                    item.total_amount,
                    unit: "₸",
                    format: "%n %u",
                    delimiter: " ",
                    separator: ","
                  ) %>
            </p>

          </div>

        <% end %>

      </div>


      <div class="mt-5 flex items-center justify-between">

        <span class="font-black">
          К оплате
        </span>

        <span class="text-2xl font-black">
          <%= number_to_currency(
                @order.total_amount,
                unit: "₸",
                format: "%n %u",
                delimiter: " ",
                separator: ","
              ) %>
        </span>

      </div>


      <button
        type="button"
        class="mt-7 h-12 w-full rounded-xl bg-[#303030] px-5 text-sm font-black text-white"
      >
        Оплатить
      </button>


      <%= link_to "Вернуться в магазин",
                  storefront_root_path(
                    shop_slug: @shop.slug
                  ),
                  class: "mt-3 flex h-11 items-center justify-center text-sm font-black text-[#616161] hover:text-black" %>

    </div>

  </main>

</div>