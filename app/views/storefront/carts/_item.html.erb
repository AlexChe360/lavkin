<%= turbo_frame_tag dom_id(item) do %>

  <div class="flex gap-4 p-5">

    <% if item.product.image.attached? %>

      <%= image_tag item.product.image,
                    class: "
                      size-24 shrink-0
                      rounded-xl
                      border border-black/10
                      bg-[#f7f7f7]
                      object-contain
                      p-2
                    " %>

    <% else %>

      <div class="
        flex size-24 shrink-0
        items-center justify-center
        rounded-xl
        border border-black/10
        bg-[#f7f7f7]
        text-xs
        text-[#8a8a8a]
      ">
        Нет фото
      </div>

    <% end %>


    <div class="min-w-0 flex-1">

      <div class="flex items-start justify-between gap-5">

        <div class="min-w-0">

          <%= link_to storefront_product_path(
                        shop_slug: shop.slug,
                        slug: item.product.slug
                      ),
                      class: "block truncate font-black hover:underline",
                      data: {
                        turbo_frame: "_top"
                      } do %>

            <%= item.product.name %>

          <% end %>


          <% if item.product.sku.present? %>
            <p class="mt-1 text-sm text-[#8a8a8a]">
              <%= item.product.sku %>
            </p>
          <% end %>

        </div>


        <p class="shrink-0 font-black">
          <%= number_to_currency(
                item.product.price * item.quantity,
                unit: "₸",
                format: "%n %u",
                delimiter: " ",
                separator: ","
              ) %>
        </p>

      </div>


      <div class="mt-5 flex items-center justify-between gap-4">

        <div class="flex items-center gap-2">

          <%= button_to storefront_cart_item_decrement_path(
                shop_slug: shop.slug,
                cart_item_id: item.id
              ),
              method: :patch,
              class: "
                flex size-10
                items-center justify-center
                rounded-xl
                border border-black/10
                bg-white
                text-lg font-black
                transition
                hover:bg-[#f3f3f3]
              ",
              aria: {
                label: "Уменьшить количество"
              } do %>

            −

          <% end %>


          <div class="
            flex h-10 min-w-12
            items-center justify-center
            rounded-xl
            border border-black/10
            bg-[#f7f7f7]
            px-3
            text-sm font-black
          ">
            <%= item.quantity %>
          </div>


          <%= button_to storefront_cart_item_increment_path(
                shop_slug: shop.slug,
                cart_item_id: item.id
              ),
              method: :patch,
              class: "
                flex size-10
                items-center justify-center
                rounded-xl
                bg-[#303030]
                text-lg font-black
                text-white
                transition
                hover:bg-black
              ",
              aria: {
                label: "Увеличить количество"
              } do %>

            +

          <% end %>

        </div>


        <%= button_to storefront_cart_item_path(
              shop_slug: shop.slug,
              id: item.id
            ),
            method: :delete,
            class: "
              flex size-10
              items-center justify-center
              rounded-xl
              border border-red-100
              bg-red-50
              text-red-600
              transition
              hover:bg-red-100
            ",
            title: "Удалить товар",
            aria: {
              label: "Удалить товар"
            } do %>

          <svg
            viewBox="0 0 24 24"
            class="size-5"
            fill="none"
            stroke="currentColor"
            stroke-width="1.8"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <path d="M3 6h18" />
            <path d="M8 6V4h8v2" />
            <path d="M19 6l-1 14H6L5 6" />
            <path d="M10 11v5" />
            <path d="M14 11v5" />
          </svg>

        <% end %>

      </div>

    </div>

  </div>

<% end %>