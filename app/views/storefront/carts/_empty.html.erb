<div
  id="cart-empty"
  class="
    mt-7 rounded-2xl
    border border-black/10
    bg-white
    px-6 py-16
    text-center
  "
>

  <h2 class="text-lg font-black">
    Корзина пустая
  </h2>

  <p class="mt-2 text-sm text-[#8a8a8a]">
    Добавьте товары из каталога.
  </p>

  <%= link_to "Перейти в каталог",
              storefront_root_path(
                shop_slug: shop.slug
              ),
              class: "
                mt-6 inline-flex h-10
                items-center
                rounded-xl
                bg-[#303030]
                px-4
                text-sm font-black
                text-white
              " %>

</div>