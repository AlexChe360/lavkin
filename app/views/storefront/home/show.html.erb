<% content_for :title, "#{@shop.name} — магазин" %>

<div class="min-h-screen bg-[#f7f7f7]">

  <!-- HEADER -->

  <header class="sticky top-0 z-30 border-b border-black/10 bg-white/95 backdrop-blur">

    <div class="mx-auto flex h-16 max-w-[1400px] items-center justify-between px-5 sm:px-6 lg:px-8">

      <%= link_to storefront_root_path(shop_slug: @shop.slug),
                  class: "flex min-w-0 items-center gap-3" do %>

        <% if @shop.storefront_logo.attached? %>

          <%= image_tag @shop.storefront_logo,
                        class: "size-10 shrink-0 rounded-xl border border-black/10 bg-white object-cover" %>

        <% else %>

          <span class="flex size-10 shrink-0 items-center justify-center rounded-xl bg-[#303030] text-sm font-black text-white">
            <%= @shop.name.first.upcase %>
          </span>

        <% end %>

        <span class="truncate text-lg font-black tracking-[-0.04em]">
          <%= @shop.name %>
        </span>

      <% end %>


      <%= link_to storefront_cart_path(
            shop_slug: @shop.slug
          ),
          class: "inline-flex h-10 items-center gap-2 rounded-xl bg-[#303030] px-4 text-sm font-black text-white transition hover:bg-black" do %>

        <svg
          width="17"
          height="17"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <circle cx="9" cy="20" r="1"/>
          <circle cx="19" cy="20" r="1"/>
          <path d="M3 4h2l2.4 10.5a2 2 0 0 0 2 1.5h7.9a2 2 0 0 0 2-1.6L21 7H6"/>
        </svg>

        <span class="hidden sm:inline">
          Корзина
        </span>

        <span id="cart-count">
          <% if @cart.total_quantity.positive? %>
            <span class="flex size-6 items-center justify-center rounded-full bg-white text-xs font-black text-[#303030]">
              <%= @cart.total_quantity %>
            </span>
          <% end %>
        </span>

      <% end %>

    </div>

  </header>


  <!-- HERO / COVER -->

  <section class="border-b border-black/10 bg-white">

    <% if @shop.storefront_cover.attached? %>

      <div class="relative h-[240px] overflow-hidden sm:h-[320px] lg:h-[380px]">

        <%= image_tag @shop.storefront_cover,
                      class: "h-full w-full object-cover" %>

        <div class="absolute inset-0 bg-black/20"></div>

      </div>

    <% else %>

      <div class="h-36 bg-[#303030] sm:h-44"></div>

    <% end %>


    <div class="mx-auto max-w-[1400px] px-5 sm:px-6 lg:px-8">

      <div class="
        relative
        <%= @shop.storefront_cover.attached? ? "-mt-14" : "-mt-10" %>
        pb-8
      ">

        <% if @shop.storefront_logo.attached? %>

          <%= image_tag @shop.storefront_logo,
                        class: "
                          size-24 rounded-2xl
                          border-4 border-white
                          bg-white object-cover
                          shadow-sm
                          sm:size-28
                        " %>

        <% else %>

          <div class="
            flex size-24 items-center justify-center
            rounded-2xl border-4 border-white
            bg-[#eeeeee]
            text-3xl font-black
            shadow-sm
            sm:size-28
          ">
            <%= @shop.name.first.upcase %>
          </div>

        <% end %>


        <div class="mt-5">

          <p class="text-xs font-black uppercase tracking-[0.14em] text-[#008060]">
            Интернет-магазин
          </p>

          <h1 class="mt-2 max-w-3xl text-3xl font-black tracking-[-0.055em] sm:text-4xl lg:text-5xl">
            <%= @shop.name %>
          </h1>


          <%
            storefront_description =
              @shop.storefront_description.presence ||
              @shop.description&.to_plain_text
          %>

          <% if storefront_description.present? %>

            <p class="mt-4 max-w-2xl text-sm leading-6 text-[#616161] sm:text-base sm:leading-7">
              <%= storefront_description %>
            </p>

          <% end %>

        </div>

      </div>

    </div>

  </section>


  <!-- CATALOG -->

  <main class="mx-auto max-w-[1400px] px-5 py-8 sm:px-6 lg:px-8 lg:py-10">

    <!-- CATEGORIES -->

    <% if @categories.any? %>

      <div class="flex gap-2 overflow-x-auto pb-2">

        <%= link_to "Все",
                    storefront_root_path(
                      shop_slug: @shop.slug
                    ),
                    class: "
                      inline-flex h-10 shrink-0 items-center rounded-full px-4
                      text-sm font-black transition
                      #{params[:category].blank? ?
                        'bg-[#303030] text-white' :
                        'border border-black/10 bg-white text-[#303030] hover:bg-[#f1f1f1]'}
                    " %>

        <% @categories.each do |category| %>

          <%= link_to category.name,
                      storefront_root_path(
                        shop_slug: @shop.slug,
                        category: category.slug
                      ),
                      class: "
                        inline-flex h-10 shrink-0 items-center rounded-full px-4
                        text-sm font-black transition
                        #{params[:category] == category.slug ?
                          'bg-[#303030] text-white' :
                          'border border-black/10 bg-white text-[#303030] hover:bg-[#f1f1f1]'}
                      " %>

        <% end %>

      </div>

    <% end %>


  <!-- PRODUCTS -->

    <% if @products.any? %>

      <div class="mt-8 grid gap-5 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4">

        <% @products.each do |product| %>

          <%= render "storefront/home/product_card",
                    product: product,
                    shop: @shop,
                    cart: @cart,
                    inventory_quantity: @inventory_quantities.fetch(product.id, 0) %>

        <% end %>

      </div>

    <% else %>

      <div class="mt-8 rounded-2xl border border-black/10 bg-white px-6 py-16 text-center">

        <div class="mx-auto flex size-12 items-center justify-center rounded-xl bg-[#f1f1f1] text-lg">
          ◻
        </div>

        <h2 class="mt-4 font-black">
          Товаров пока нет
        </h2>

        <p class="mt-2 text-sm text-[#8a8a8a]">
          В этой категории пока ничего не опубликовано.
        </p>

      </div>

    <% end %>


  </main>


  <!-- FOOTER -->

  <footer class="mt-10 border-t border-black/10 bg-white">

    <div class="mx-auto flex max-w-[1400px] flex-col gap-2 px-5 py-8 text-sm text-[#8a8a8a] sm:flex-row sm:items-center sm:justify-between sm:px-6 lg:px-8">

      <p>
        © <%= Time.current.year %> <%= @shop.name %>
      </p>

      <p>
        Работает на Lavkin
      </p>

    </div>

  </footer>

</div>