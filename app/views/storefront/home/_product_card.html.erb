<%
  cart_item =
    cart
      .cart_items
      .find { |item| item.product_id == product.id }
%>

<div id="<%= dom_id(product, :storefront) %>">

  <article class="
    group overflow-hidden
    rounded-2xl
    border border-black/10
    bg-white
    transition
    hover:-translate-y-0.5
    hover:shadow-lg
  ">

    <!-- IMAGE -->

    <%= link_to storefront_product_path(
          shop_slug: shop.slug,
          slug: product.slug
        ),
        class: "block",
        data: {
          turbo_frame: "_top"
        } do %>

      <div class="relative aspect-square overflow-hidden bg-[#f1f1f1]">

        <% if product.image.attached? %>

          <%= image_tag product.image,
                        class: "
                          h-full w-full
                          object-contain p-6
                          transition duration-300
                          group-hover:scale-[1.03]
                        " %>

        <% else %>

          <div class="
            flex h-full items-center justify-center
            text-sm font-bold text-[#8a8a8a]
          ">
            Нет изображения
          </div>

        <% end %>


        <% if inventory_quantity <= 0 %>

          <span class="
            absolute left-3 top-3
            rounded-full
            bg-white/95
            px-3 py-1
            text-xs font-black
            text-[#616161]
            shadow-sm
          ">
            Нет в наличии
          </span>

        <% end %>

      </div>

    <% end %>


    <!-- CONTENT -->

    <div class="p-5">

      <% if product.category.present? %>

        <p class="text-xs font-bold text-[#8a8a8a]">
          <%= product.category.name %>
        </p>

      <% end %>


      <%= link_to storefront_product_path(
            shop_slug: shop.slug,
            slug: product.slug
          ),
          class: "mt-2 block",
          data: {
            turbo_frame: "_top"
          } do %>

        <h2 class="
          line-clamp-2
          text-lg font-black
          tracking-[-0.03em]
          transition
          group-hover:underline
        ">
          <%= product.name %>
        </h2>

      <% end %>


      <div class="mt-5 flex items-end justify-between gap-4">

        <!-- PRICE -->

        <div>

          <p class="text-lg font-black">
            <%= number_to_currency(
                  product.price,
                  unit: "₸",
                  format: "%n %u",
                  delimiter: " ",
                  separator: ","
                ) %>
          </p>


          <% if product.compare_at_price.present? &&
                product.compare_at_price > product.price %>

            <p class="mt-1 text-xs text-[#8a8a8a] line-through">
              <%= number_to_currency(
                    product.compare_at_price,
                    unit: "₸",
                    format: "%n %u",
                    delimiter: " ",
                    separator: ","
                  ) %>
            </p>

          <% end %>

        </div>


        <!-- CART CONTROLS -->

        <% if inventory_quantity.positive? %>

          <% if cart_item.present? %>

            <div class="flex items-center gap-2">

              <!-- MINUS -->

              <%= button_to storefront_cart_item_decrement_path(
                    shop_slug: shop.slug,
                    cart_item_id: cart_item.id
                  ),
                  method: :patch,
                  class: "
                    flex size-10 shrink-0
                    items-center justify-center
                    rounded-xl
                    border border-black/10
                    bg-white
                    text-lg font-black
                    transition
                    hover:bg-[#f3f3f3]
                  ",
                  aria: {
                    label: "Уменьшить количество"
                  } do %>

                −

              <% end %>


              <!-- QUANTITY -->

              <div class="
                flex h-10 min-w-10
                items-center justify-center
                rounded-xl
                border border-black/10
                bg-[#f7f7f7]
                px-3
                text-sm font-black
              ">
                <%= cart_item.quantity %>
              </div>


              <!-- PLUS -->

              <%= button_to storefront_cart_item_increment_path(
                    shop_slug: shop.slug,
                    cart_item_id: cart_item.id
                  ),
                  method: :patch,
                  class: "
                    flex size-10 shrink-0
                    items-center justify-center
                    rounded-xl
                    bg-[#303030]
                    text-xl font-black
                    text-white
                    transition
                    hover:bg-black
                  ",
                  aria: {
                    label: "Увеличить количество"
                  } do %>

                +

              <% end %>

            </div>

          <% else %>

            <%= button_to storefront_cart_items_path(
                  shop_slug: shop.slug
                ),
                params: {
                  product_id: product.id
                },
                method: :post,
                class: "
                  flex size-10 shrink-0
                  items-center justify-center
                  rounded-xl
                  bg-[#303030]
                  text-xl font-black
                  text-white
                  transition
                  hover:bg-black
                ",
                title: "Добавить в корзину",
                aria: {
                  label: "Добавить в корзину"
                } do %>

              +

            <% end %>

          <% end %>

        <% else %>

          <span class="text-xs font-bold text-[#8a8a8a]">
            Нет в наличии
          </span>

        <% end %>

      </div>

    </div>

  </article>

</div>