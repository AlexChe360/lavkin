<% content_for :title, "Регистрация — Lavkin" %>

<div>

  <div>

    <% if @invitation %>

      <p class="text-sm font-black uppercase tracking-[0.14em] text-[#008060]">
        Приглашение
      </p>

      <h1 class="mt-3 text-4xl font-black tracking-[-0.05em]">
        Создать аккаунт
      </h1>

      <p class="mt-3 text-base leading-7 text-[#616161]">
        Создайте аккаунт, чтобы присоединиться к
        <strong class="text-[#303030]">
          <%= @invitation.account.name %>
        </strong>.
      </p>

    <% else %>

      <p class="text-sm font-black uppercase tracking-[0.14em] text-[#008060]">
        Начало работы
      </p>

      <h1 class="mt-3 text-4xl font-black tracking-[-0.05em]">
        Создать аккаунт
      </h1>

      <p class="mt-3 text-base leading-7 text-[#616161]">
        Создайте аккаунт Lavkin и пространство для вашего бизнеса.
      </p>

    <% end %>

  </div>


  <% if @user.errors.any? || @account.errors.any? %>

    <div class="mt-6 rounded-xl border border-red-200 bg-red-50 px-4 py-4">

      <p class="text-sm font-black text-red-700">
        Проверьте введённые данные
      </p>

      <ul class="mt-2 list-disc space-y-1 pl-5 text-sm text-red-600">

        <% @user.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>

        <% @account.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>

      </ul>

    </div>

  <% end %>


  <%= form_with url: registration_path,
                class: "mt-8 space-y-5" do |form| %>


    <% unless @invitation %>

      <div>

        <%= label_tag "account[name]",
                      "Название бизнеса",
                      class: "block text-sm font-black text-[#303030]" %>

        <%= text_field_tag "account[name]",
                           @account.name,
                           required: true,
                           autofocus: true,
                           autocomplete: "organization",
                           placeholder: "Coffee Group",
                           class: "mt-2 h-12 w-full rounded-xl border border-black/10 bg-white px-4 text-sm outline-none transition placeholder:text-[#a1a1a1] focus:border-[#008060] focus:ring-2 focus:ring-[#008060]/10" %>

      </div>

    <% end %>


    <div>

      <%= label_tag "user[email_address]",
                    "Email",
                    class: "block text-sm font-black text-[#303030]" %>

      <%= email_field_tag "user[email_address]",
                          @user.email_address,
                          required: true,
                          readonly: @invitation.present?,
                          autocomplete: "email",
                          placeholder: "you@example.com",
                          class: "mt-2 h-12 w-full rounded-xl border border-black/10 bg-white px-4 text-sm outline-none transition placeholder:text-[#a1a1a1] focus:border-[#008060] focus:ring-2 focus:ring-[#008060]/10" %>

      <% if @invitation %>
        <p class="mt-2 text-xs text-[#8a8a8a]">
          Приглашение отправлено на этот email.
        </p>
      <% end %>

    </div>


    <div>

      <%= label_tag "user[password]",
                    "Пароль",
                    class: "block text-sm font-black text-[#303030]" %>

      <%= password_field_tag "user[password]",
                             nil,
                             required: true,
                             autocomplete: "new-password",
                             placeholder: "Минимум 8 символов",
                             class: "mt-2 h-12 w-full rounded-xl border border-black/10 bg-white px-4 text-sm outline-none transition placeholder:text-[#a1a1a1] focus:border-[#008060] focus:ring-2 focus:ring-[#008060]/10" %>

    </div>


    <div>

      <%= label_tag "user[password_confirmation]",
                    "Повторите пароль",
                    class: "block text-sm font-black text-[#303030]" %>

      <%= password_field_tag "user[password_confirmation]",
                             nil,
                             required: true,
                             autocomplete: "new-password",
                             placeholder: "Повторите пароль",
                             class: "mt-2 h-12 w-full rounded-xl border border-black/10 bg-white px-4 text-sm outline-none transition placeholder:text-[#a1a1a1] focus:border-[#008060] focus:ring-2 focus:ring-[#008060]/10" %>

    </div>


    <%= submit_tag(
          @invitation ? "Создать аккаунт и продолжить" : "Создать аккаунт",
          class: "h-12 w-full cursor-pointer rounded-xl bg-[#303030] px-5 text-sm font-black text-white transition hover:bg-black"
        ) %>

  <% end %>


  <div class="mt-7 border-t border-black/10 pt-6 text-center">

    <p class="text-sm text-[#616161]">
      Уже есть аккаунт?

      <%= link_to "Войти",
                  new_session_path,
                  class: "font-black text-[#111111] hover:underline" %>
    </p>

  </div>

</div>