<%= form_with model: [:admin, category],
              class: "space-y-6" do |form| %>

  <% if category.errors.any? %>

    <div class="
      rounded-xl border border-red-200
      bg-red-50 p-4
    ">

      <p class="text-sm font-black text-red-700">
        Проверьте введённые данные
      </p>

      <ul class="mt-2 list-disc pl-5 text-sm text-red-700">

        <% category.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>

      </ul>

    </div>

  <% end %>


  <div>

    <%= form.label :name,
                   "Название",
                   class: "text-sm font-black" %>

    <%= form.text_field :name,
                        placeholder: "Например, Кофе",
                        class: "
                          mt-2 h-11 w-full
                          rounded-xl border border-black/10
                          bg-white px-4 text-sm
                          outline-none
                          transition
                          focus:border-[#008060]
                          focus:ring-2
                          focus:ring-[#008060]/10
                        " %>

  </div>


  <div>

    <%= form.label :slug,
                   "Адрес категории",
                   class: "text-sm font-black" %>

    <%= form.text_field :slug,
                        placeholder: "coffee",
                        class: "
                          mt-2 h-11 w-full
                          rounded-xl border border-black/10
                          bg-white px-4
                          font-mono text-sm
                          outline-none
                          transition
                          focus:border-[#008060]
                          focus:ring-2
                          focus:ring-[#008060]/10
                        " %>

    <p class="mt-2 text-xs text-[#8a8a8a]">
      Например: coffee, desserts, accessories
    </p>

  </div>


  <div>

    <%= form.label :description,
                 "Описание",
                 class: "block text-sm font-black text-[#303030]" %>

    <div class="mt-3">
      <%= form.rich_text_area :description,
                              placeholder: "Описание категории..." %>
    </div>

  </div>


  <div>

    <%= form.label :position,
                   "Позиция",
                   class: "text-sm font-black" %>

    <%= form.number_field :position,
                          min: 0,
                          class: "
                            mt-2 h-11 w-full
                            rounded-xl border border-black/10
                            bg-white px-4 text-sm
                            outline-none
                          " %>

    <p class="mt-2 text-xs text-[#8a8a8a]">
      Чем меньше число, тем выше категория отображается в каталоге.
    </p>

  </div>


  <label class="
    flex cursor-pointer
    items-center justify-between
    rounded-xl border border-black/10
    p-4
  ">

    <div>

      <p class="text-sm font-black">
        Активная категория
      </p>

      <p class="mt-1 text-xs text-[#8a8a8a]">
        Категория будет доступна в интернет-магазине.
      </p>

    </div>

    <%= form.check_box :active,
                       class: "
                         size-5 rounded
                         border-black/20
                         text-[#008060]
                         focus:ring-[#008060]
                       " %>

  </label>


  <div class="
    flex items-center justify-end
    gap-3 border-t border-black/10
    pt-5
  ">

    <%= link_to "Отмена",
                admin_categories_path,
                class: "
                  inline-flex h-10
                  items-center rounded-xl
                  border border-black/10
                  px-4 text-sm font-black
                  hover:bg-[#f7f7f7]
                " %>

    <%= form.submit(
          category.persisted? ? "Сохранить" : "Создать категорию",
          class: "
            h-10 cursor-pointer
            rounded-xl bg-[#303030]
            px-5 text-sm font-black
            text-white hover:bg-black
          "
        ) %>

  </div>

<% end %>