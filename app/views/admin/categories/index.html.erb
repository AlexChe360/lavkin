<% content_for :title, "Категории — Lavkin" %>

<div>

  <div class="flex items-start justify-between gap-6">

    <div>

      <h1 class="text-2xl font-black tracking-[-0.04em]">
        Категории
      </h1>

      <p class="mt-1 text-sm text-[#616161]">
        Организуйте товары магазина
        <strong class="text-[#303030]">
          <%= Current.shop.name %>
        </strong>
      </p>

    </div>

    <%= link_to "Добавить категорию",
                new_admin_category_path,
                class: "
                  inline-flex h-10 items-center justify-center
                  rounded-xl bg-[#303030] px-4
                  text-sm font-black text-white
                  transition hover:bg-black
                " %>

  </div>


  <div class="mt-7 overflow-hidden rounded-2xl border border-black/10 bg-white">

    <% if @categories.any? %>

      <div class="divide-y divide-black/10">

        <% @categories.each do |category| %>

          <div class="flex items-center justify-between gap-5 px-5 py-4">

            <div class="min-w-0">

              <div class="flex items-center gap-3">

                <p class="truncate text-sm font-black">
                  <%= category.name %>
                </p>

                <% if category.active? %>

                  <span class="
                    rounded-full
                    bg-[#e3f1df]
                    px-2.5 py-1
                    text-[11px] font-black
                    text-[#0a5c36]
                  ">
                    Активна
                  </span>

                <% else %>

                  <span class="
                    rounded-full
                    bg-[#eeeeee]
                    px-2.5 py-1
                    text-[11px] font-black
                    text-[#616161]
                  ">
                    Скрыта
                  </span>

                <% end %>

              </div>

              <p class="mt-1 text-xs text-[#8a8a8a]">
                /<%= category.slug %>
              </p>

            </div>


            <div class="flex items-center gap-4">

              <span class="text-xs text-[#8a8a8a]">
                Позиция: <%= category.position %>
              </span>

              <%= link_to "Редактировать",
                          edit_admin_category_path(category),
                          class: "
                            text-sm font-bold
                            text-[#616161]
                            hover:text-black
                          " %>

              <%= button_to "Удалить",
                admin_category_path(category),
                method: :delete,
                form: {
                  data: {
                    turbo_confirm: "Удалить категорию «#{category.name}»?"
                  }
                },
                class: "text-sm font-bold text-red-600 hover:text-red-700" %>

            </div>

          </div>

        <% end %>

      </div>

    <% else %>

      <div class="px-6 py-14 text-center">

        <div class="
          mx-auto flex size-12
          items-center justify-center
          rounded-xl bg-[#f1f1f1]
          text-xl
        ">
          #
        </div>

        <h2 class="mt-4 font-black">
          Категорий пока нет
        </h2>

        <p class="mx-auto mt-2 max-w-sm text-sm text-[#8a8a8a]">
          Создайте категории, чтобы организовать товары магазина.
        </p>

        <%= link_to "Создать категорию",
                    new_admin_category_path,
                    class: "
                      mt-5 inline-flex h-10
                      items-center justify-center
                      rounded-xl bg-[#303030]
                      px-4 text-sm font-black
                      text-white
                      hover:bg-black
                    " %>

      </div>

    <% end %>

  </div>

</div>