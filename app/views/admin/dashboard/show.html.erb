<% content_for :title, "Главная — Lavkin" %>

<div>

  <!-- HEADER -->

  <div>

    <h1 class="text-2xl font-black tracking-[-0.04em]">
      Главная
    </h1>

    <p class="mt-1 text-sm text-[#616161]">
      Обзор бизнеса
      <strong class="font-bold text-[#303030]">
        <%= Current.account.name %>
      </strong>
    </p>

  </div>



  <!-- KPI -->

  <div class="mt-7 grid gap-4 sm:grid-cols-2 xl:grid-cols-4">

    <% [
      [
        "Продажи сегодня",
        number_to_currency(
          @sales_today,
          unit: "₸",
          format: "%n %u",
          delimiter: " ",
          separator: ","
        ),
        "Оплаченные заказы"
      ],
      [
        "Заказы",
        @orders_today_count,
        "Сегодня"
      ],
      ["Товары",  @products_count, "В каталоге"],
      ["Остатки", @inventory_count, "Доступно"]
    ].each do |label, value, meta| %>

      <div class="rounded-2xl border border-black/10 bg-white p-5">

        <p class="text-xs font-black uppercase tracking-[0.1em] text-[#8a8a8a]">
          <%= label %>
        </p>

        <p class="mt-4 text-2xl font-black tracking-[-0.04em]">
          <%= value %>
        </p>

        <p class="mt-2 text-xs font-semibold text-[#8a8a8a]">
          <%= meta %>
        </p>

      </div>

    <% end %>

  </div>



  <!-- CONTENT -->

  <div class="mt-5 grid gap-5 xl:grid-cols-[1.5fr_1fr]">


    <!-- ORDERS -->

    <section class="overflow-hidden rounded-2xl border border-black/10 bg-white">

  <div class="flex items-center justify-between border-b border-black/10 px-5 py-4">

    <div>
      <h2 class="font-black">
        Последние заказы
      </h2>

      <p class="mt-1 text-sm text-[#8a8a8a]">
        Последние оформленные заказы.
      </p>
    </div>

  </div>


  <% if @recent_orders.any? %>

    <div class="divide-y divide-black/10">

      <% @recent_orders.each do |order| %>

        <div class="flex items-center justify-between gap-5 px-5 py-4">

          <div>

            <p class="text-sm font-black">
              <%= order.number %>
            </p>

            <p class="mt-1 text-xs text-[#8a8a8a]">
              <%= order.customer_name.presence || "Клиент" %>
              ·
              <%= l(order.created_at, format: :short) rescue order.created_at.strftime("%d.%m %H:%M") %>
            </p>

          </div>


          <div class="flex items-center gap-5">

            <span
              class="
                rounded-full px-2.5 py-1
                text-[11px] font-black
                <%= order.status == "paid" ?
                      "bg-[#e3f1df] text-[#0a5c36]" :
                      "bg-[#eeeeee] text-[#616161]" %>
              "
            >
              <%= order.status %>
            </span>


            <p class="min-w-[100px] text-right text-sm font-black">
              <%= number_to_currency(
                    order.total_amount,
                    unit: "₸",
                    format: "%n %u",
                    delimiter: " ",
                    separator: ","
                  ) %>
            </p>

          </div>

        </div>

      <% end %>

    </div>

  <% else %>

    <div class="px-5 py-16 text-center">
      <p class="text-sm text-[#8a8a8a]">
        Заказов пока нет.
      </p>
    </div>

  <% end %>

</section>



    <!-- SETUP -->

    <section class="rounded-2xl border border-black/10 bg-white p-5">

      <h2 class="font-black">
        Начало работы
      </h2>

      <p class="mt-1 text-sm text-[#8a8a8a]">
        Подготовьте Lavkin к первым продажам.
      </p>


      <div class="mt-6 space-y-3">

        <% [
          ["Создать магазин", @has_shop],
          ["Добавить первый товар", @has_product],
          ["Настроить склад", @has_inventory],
          ["Оформить витрину", @has_storefront],
          ["Подключить эквайринг", @has_acquiring]
        ].each do |label, complete| %>

          <div
            class="
              flex items-center gap-3 rounded-xl px-4 py-3
              <%= complete ? "bg-[#edf7f2]" : "bg-[#f7f7f7]" %>
            "
          >

            <span
              class="
                flex size-6 shrink-0 items-center justify-center
                rounded-full border text-[11px] font-black
                <%= complete ?
                  "border-[#008060] bg-[#008060] text-white" :
                  "border-black/10 text-transparent" %>
              "
            >
              ✓
            </span>

            <span
              class="
                text-sm font-bold
                <%= complete ? "text-[#006e52]" : "text-[#303030]" %>
              "
            >
              <%= label %>
            </span>

          </div>

        <% end %>

      </div>

    </section>

  </div>

</div>