<aside
  data-mobile-menu-target="menu"
  class="
    fixed inset-y-0 left-0 z-50
    flex w-[240px]
    -translate-x-full
    flex-col
    border-r border-black/10
    bg-[#ebebeb]
    transition-transform
    duration-200
    ease-out
    lg:translate-x-0
  "
>

  <!-- ====================================================== -->
  <!-- LOGO                                                   -->
  <!-- ====================================================== -->

  <div class="flex h-16 shrink-0 items-center justify-between px-4">

    <%= link_to admin_root_path,
                class: "flex items-center gap-3" do %>

      <%= image_tag "lavkin-mark.png",
                    alt: "Lavkin",
                    class: "size-9 shrink-0 object-contain" %>

      <span class="text-lg font-black tracking-[-0.04em]">
        Lavkin
      </span>

    <% end %>


    <button
      type="button"
      data-action="click->mobile-menu#close"
      class="
        flex size-9
        items-center justify-center
        rounded-lg
        text-[#616161]
        transition
        hover:bg-black/5
        hover:text-black
        lg:hidden
      "
      aria-label="Закрыть меню"
    >
      <svg
        width="20"
        height="20"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
      >
        <path d="M6 6l12 12"/>
        <path d="M18 6L6 18"/>
      </svg>
    </button>

  </div>



  <!-- ====================================================== -->
  <!-- ACCOUNT                                                -->
  <!-- ====================================================== -->

  <div class="shrink-0 px-3">

    <div
      class="
        rounded-xl px-3 py-3
        transition hover:bg-black/5
      "
    >

      <p class="text-[10px] font-black uppercase tracking-[0.12em] text-[#8a8a8a]">
        Бизнес
      </p>

      <div class="mt-1 flex items-center justify-between gap-3">

        <p class="min-w-0 truncate text-sm font-black">
          <%= Current.account&.name || "Бизнес не выбран" %>
        </p>

        <svg
          class="shrink-0 text-[#8a8a8a]"
          width="15"
          height="15"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
        >
          <path d="m6 9 6 6 6-6"/>
        </svg>

      </div>

    </div>

  </div>



  <!-- ====================================================== -->
  <!-- CURRENT SHOP                                           -->
  <!-- ====================================================== -->

  <div class="mt-2 shrink-0 px-3">

    <% if Current.shop.present? %>

      <div class="rounded-xl border border-black/10 bg-white p-3">

        <p class="text-[10px] font-black uppercase tracking-[0.12em] text-[#8a8a8a]">
          Магазин
        </p>

        <div class="mt-2 flex items-center justify-between gap-3">

          <div class="min-w-0">

            <p class="truncate text-sm font-black">
              <%= Current.shop.name %>
            </p>

            <p class="mt-0.5 truncate text-xs text-[#8a8a8a]">
              /<%= Current.shop.slug %>
            </p>

          </div>

          <%= link_to admin_shops_path,
                      class: "
                        shrink-0 text-xs font-black
                        text-[#008060]
                        transition hover:underline
                      " do %>
            Сменить
          <% end %>

        </div>

      </div>

    <% else %>

      <%= link_to new_admin_shop_path,
                  class: "
                    block rounded-xl
                    border border-dashed border-black/15
                    bg-white/50 p-3
                    transition hover:bg-white
                  " do %>

        <p class="text-[10px] font-black uppercase tracking-[0.12em] text-[#8a8a8a]">
          Магазин
        </p>

        <p class="mt-2 text-sm font-black">
          + Создать магазин
        </p>

      <% end %>

    <% end %>

  </div>



  <!-- ====================================================== -->
  <!-- NAVIGATION                                             -->
  <!-- ====================================================== -->

  <nav class="mt-5 flex-1 overflow-y-auto px-3 pb-5">


    <!-- MAIN -->

    <div class="space-y-1">

      <%= link_to admin_root_path,
                  class: admin_nav_class(admin_root_path, exact: true) do %>

        <svg
          width="18"
          height="18"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.8"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <rect x="3" y="3" width="7" height="7" rx="1"/>
          <rect x="14" y="3" width="7" height="7" rx="1"/>
          <rect x="3" y="14" width="7" height="7" rx="1"/>
          <rect x="14" y="14" width="7" height="7" rx="1"/>
        </svg>

        Главная

      <% end %>


      <%= link_to admin_orders_path,
            class: admin_nav_class(admin_orders_path) do %>

        <svg
          width="18"
          height="18"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.8"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <path d="M6 2h12l2 5H4z"/>
          <path d="M4 7v15h16V7"/>
          <path d="M9 12h6"/>
        </svg>

        Заказы

      <% end %>

    </div>



    <!-- CATALOG -->

    <p class="mb-2 mt-7 px-3 text-[10px] font-black uppercase tracking-[0.14em] text-[#8a8a8a]">
      Каталог
    </p>

    <div class="space-y-1">

      <%= link_to admin_products_path,
            class: admin_nav_class(admin_products_path) do %>

          <svg
            width="18"
            height="18"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.8"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <path d="M6 4h12"/>
            <path d="M6 10h12"/>
            <path d="M6 16h12"/>
            <circle cx="3" cy="4" r="1"/>
            <circle cx="3" cy="10" r="1"/>
            <circle cx="3" cy="16" r="1"/>
          </svg>

        Товары

      <% end %>


      <%= link_to admin_categories_path,
            class: admin_nav_class(admin_categories_path) do %>

          <svg
            width="18"
            height="18"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.8"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <path d="M4 6h16"/>
            <path d="M4 12h10"/>
            <path d="M4 18h7"/>
        </svg>

          Категории

        <% end %>

      </a>

    </div>



    <!-- INVENTORY -->

    <p class="mb-2 mt-7 px-3 text-[10px] font-black uppercase tracking-[0.14em] text-[#8a8a8a]">
      Склад
    </p>

    <div class="space-y-1">

      <%= link_to admin_locations_path,
            class: admin_nav_class(admin_locations_path) do %>

        <svg
          width="18"
          height="18"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.8"
        >
          <path d="M3 21V7l9-4 9 4v14"/>
          <path d="M7 21v-7h10v7"/>
        </svg>

        Склады

      <% end %>

      <%= link_to admin_inventory_path,
            class: admin_nav_class(
              admin_inventory_path,
              exact: true
            ) do %>

        <svg
          width="18"
          height="18"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.8"
        >
          <path d="m21 8-9 5-9-5"/>
          <path d="m3 8 9-5 9 5v8l-9 5-9-5V8Z"/>
          <path d="M12 13v8"/>
        </svg>

        Остатки

      <% end %>

      <%= link_to admin_inventory_movements_path,
            class: admin_nav_class(
              admin_inventory_movements_path
            ) do %>

        <svg
          width="18"
          height="18"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.8"
        >
          <path d="M4 7h16"/>
          <path d="M4 12h16"/>
          <path d="M4 17h10"/>
        </svg>

        История движений

      <% end %>

      <% if Current.membership&.owner? || Current.membership&.admin? %>

        <%= link_to admin_inventory_counts_path,
              class: admin_nav_class(admin_inventory_counts_path) do %>

          <svg
            width="18"
            height="18"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.8"
          >
            <path d="M9 11l3 3L22 4"/>
            <path d="M21 12v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11"/>
          </svg>

          Инвентаризации

        <% end %>


        <%= link_to admin_stock_transfers_path,
              class: admin_nav_class(admin_stock_transfers_path) do %>

          <svg
            width="18"
            height="18"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.8"
          >
            <path d="M7 7h11l-3-3"/>
            <path d="m18 7-3 3"/>
            <path d="M17 17H6l3 3"/>
            <path d="m6 17 3-3"/>
          </svg>

          Перемещения

        <% end %>
      <% end %>

    </div>



    <!-- SALES CHANNELS -->

    <p class="mb-2 mt-7 px-3 text-[10px] font-black uppercase tracking-[0.14em] text-[#8a8a8a]">
      Каналы продаж
    </p>

    <div class="space-y-1">

      <%= link_to admin_storefront_path,
            class: admin_nav_class(admin_storefront_path) do %>

        <svg
          width="18"
          height="18"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
        >
          <circle cx="12" cy="12" r="9"/>
          <path d="M3 12h18"/>
          <path d="M12 3a15 15 0 0 1 0 18"/>
          <path d="M12 3a15 15 0 0 0 0 18"/>
        </svg>

        <span>Интернет-магазин</span>

      <% end %>

    </div>



    <!-- FINANCE -->

    <% if Current.membership&.owner? || Current.membership&.admin? %>

      <p class="mb-2 mt-7 px-3 text-[10px] font-black uppercase tracking-[0.14em] text-[#8a8a8a]">
        Финансы
      </p>

      <div class="space-y-1">

          <% if Current.membership&.owner? %>

            <%= link_to admin_payments_path,
                        class: "
                          flex items-center gap-3
                          rounded-xl
                          px-3 py-2.5
                          text-sm font-bold
                          transition
                          hover:bg-black/5
                        " do %>

              Платежи

            <% end %>

          <% end %>

      </div>
    <% end %>

  </nav>



  <!-- ====================================================== -->
  <!-- BOTTOM SETTINGS                                        -->
  <!-- ====================================================== -->

  <div class="shrink-0 border-t border-black/10 p-3">

    <div class="space-y-1">

      <% if Current.membership&.owner? || Current.membership&.admin? %>

        <%= link_to admin_shops_path,
                  class: admin_nav_class(admin_shops_path) do %>

        <svg
          width="18"
          height="18"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.8"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <path d="M4 10v10h16V10"/>
          <path d="M3 10 5 4h14l2 6"/>
          <path d="M9 20v-5h6v5"/>
        </svg>

        Магазины

        <% end %>

        <%= link_to admin_members_path,
              class: admin_nav_class(admin_members_path) do %>

          <svg
            width="18"
            height="18"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.8"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/>
            <circle cx="9" cy="7" r="4"/>
            <path d="M22 21v-2a4 4 0 0 0-3-3.87"/>
            <path d="M16 3.13a4 4 0 0 1 0 7.75"/>
          </svg>

          Сотрудники

        <% end %>

        <% if Current.membership&.owner? %>

          <%= link_to admin_business_settings_path,
                      class: "
                        flex items-center gap-3
                        rounded-xl
                        px-3 py-2.5
                        text-sm font-bold
                        transition
                        hover:bg-black/5
                      " do %>

            <svg
              width="18"
              height="18"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.8"
            >
              <circle cx="12" cy="12" r="3"/>
              <path d="
                M19.4 15
                a1.65 1.65 0 0 0 .33 1.82
                l.06.06
                a2 2 0 1 1-2.83 2.83
                l-.06-.06
                A1.65 1.65 0 0 0 15 19.4
                a1.65 1.65 0 0 0-1 .6
                V20
                a2 2 0 1 1-4 0
                v-.09
                a1.65 1.65 0 0 0-1-.6
                a1.65 1.65 0 0 0-1.82.33
                l-.06.06
                a2 2 0 1 1-2.83-2.83
                l.06-.06
                A1.65 1.65 0 0 0 4.6 15
                a1.65 1.65 0 0 0-.6-1
                H4
                a2 2 0 1 1 0-4
                h.09
                a1.65 1.65 0 0 0 .6-1
                a1.65 1.65 0 0 0-.33-1.82
                l-.06-.06
                a2 2 0 1 1 2.83-2.83
                l.06.06
                A1.65 1.65 0 0 0 9 4.6
                a1.65 1.65 0 0 0 1-.6
                V4
                a2 2 0 1 1 4 0
                v.09
                a1.65 1.65 0 0 0 1 .6
                a1.65 1.65 0 0 0 1.82-.33
                l.06-.06
                a2 2 0 1 1 2.83 2.83
                l-.06.06
                A1.65 1.65 0 0 0 19.4 9
                a1.65 1.65 0 0 0 .6 1
                H20
                a2 2 0 1 1 0 4
                h-.09
                a1.65 1.65 0 0 0-.51 1
              "/>
            </svg>

            Настройки бизнеса

          <% end %>

        <% end %>
      <% end %>

    </div>

  </div>

</aside>