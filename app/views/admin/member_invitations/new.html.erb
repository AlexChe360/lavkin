<% content_for :title, "Пригласить сотрудника — Lavkin" %>

<div class="mx-auto max-w-2xl">

  <%= link_to "← Сотрудники",
              admin_members_path,
              class: "text-sm font-bold text-[#616161] hover:text-black" %>

  <div class="mt-5">

    <h1 class="text-2xl font-black tracking-[-0.04em]">
      Пригласить сотрудника
    </h1>

    <p class="mt-1 text-sm text-[#616161]">
      Добавьте сотрудника в
      <strong class="text-[#303030]">
        <%= Current.account.name %>
      </strong>.
    </p>

  </div>


  <section class="mt-7 rounded-2xl border border-black/10 bg-white p-6">

    <%= form_with model: [:admin, @invitation],
                  class: "space-y-6" do |form| %>

      <% if @invitation.errors.any? %>

        <div class="rounded-xl border border-red-200 bg-red-50 p-4">

          <% @invitation.errors.full_messages.each do |message| %>
            <p class="text-sm font-bold text-red-700">
              <%= message %>
            </p>
          <% end %>

        </div>

      <% end %>


      <div>

        <%= form.label :email,
                       "Email",
                       class: "block text-sm font-black" %>

        <%= form.email_field :email,
                             required: true,
                             autofocus: true,
                             placeholder: "manager@coffee.kz",
                             class: "mt-2 h-11 w-full rounded-xl border border-black/10 bg-white px-4 text-sm outline-none focus:border-[#008060]" %>

      </div>


      <div>

        <%= form.label :role,
                       "Роль",
                       class: "block text-sm font-black" %>

        <%= form.select :role,
                        options_for_select(
                          [
                            ["Администратор", "admin"],
                            ["Менеджер", "manager"],
                            ["Сотрудник", "staff"]
                          ],
                          @invitation.role
                        ),
                        {
                          prompt: "Выберите роль"
                        },
                        class: "mt-2 h-11 w-full rounded-xl border border-black/10 bg-white px-3 text-sm" %>

      </div>


      <div class="flex justify-end gap-3 border-t border-black/10 pt-5">

        <%= link_to "Отмена",
                    admin_members_path,
                    class: "inline-flex h-10 items-center rounded-xl border border-black/10 px-4 text-sm font-black hover:bg-[#f7f7f7]" %>

        <%= form.submit "Создать приглашение",
                        class: "h-10 cursor-pointer rounded-xl bg-[#303030] px-5 text-sm font-black text-white hover:bg-black" %>

      </div>

    <% end %>

  </section>

</div>