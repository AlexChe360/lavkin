<%= form_with model: [:admin, shop],
              class: "space-y-6" do |form| %>

  <% if shop.errors.any? %>

    <div class="rounded-xl border border-red-200 bg-red-50 px-4 py-4">

      <p class="text-sm font-black text-red-700">
        Проверьте данные
      </p>

      <ul class="mt-2 list-disc space-y-1 pl-5 text-sm text-red-600">

        <% shop.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>

      </ul>

    </div>

  <% end %>


  <div>

    <%= form.label :name,
                   "Название магазина",
                   class: "block text-sm font-black" %>

    <%= form.text_field :name,
                        autofocus: true,
                        placeholder: "Coffee Time",
                        class: "mt-2 h-11 w-full rounded-xl border border-black/10 bg-white px-4 text-sm outline-none focus:border-[#008060]" %>

  </div>


  <div>

    <%= form.label :slug,
                   "Адрес магазина",
                   class: "block text-sm font-black" %>

    <%= form.text_field :slug,
                        placeholder: "coffee-time",
                        class: "mt-2 h-11 w-full rounded-xl border border-black/10 bg-white px-4 font-mono text-sm outline-none focus:border-[#008060]" %>

    <p class="mt-2 text-xs text-[#8a8a8a]">
      Адрес витрины:
      /store/<span id="shop-slug-preview"><%= shop.slug.presence || "coffee-time" %></span>
    </p>

  </div>


  <div>

  <%= form.label :description,
                 "Описание",
                 class: "block text-sm font-black text-[#303030]" %>

    <p class="mt-1 text-xs text-[#8a8a8a]">
      Расскажите о магазине. Можно использовать форматирование,
      списки и ссылки.
    </p>

    <div class="mt-3">
      <%= form.rich_text_area :description,
                              placeholder: "Кратко расскажите о магазине..." %>
    </div>

</div>


  <% if shop.persisted? %>

    <div>

      <%= form.label :status,
                     "Статус",
                     class: "block text-sm font-black" %>

      <%= form.select :status,
                      Shop.statuses.keys.map {
                        |status|
                        [
                          status.humanize,
                          status
                        ]
                      },
                      {},
                      class: "mt-2 h-11 w-full rounded-xl border border-black/10 bg-white px-3 text-sm" %>

    </div>

  <% end %>


  <div class="flex justify-end gap-3">

    <%= link_to "Отмена",
                admin_shops_path,
                class: "inline-flex h-10 items-center justify-center rounded-xl border border-black/10 px-4 text-sm font-bold" %>

    <%= form.submit shop.persisted? ? "Сохранить" : "Создать магазин",
                    class: "h-10 cursor-pointer rounded-xl bg-[#303030] px-5 text-sm font-black text-white hover:bg-black" %>

  </div>

<% end %>