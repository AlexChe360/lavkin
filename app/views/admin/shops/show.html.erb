<% content_for :title, "#{@shop.name} — Lavkin" %>

<div>

  <%= link_to "← Магазины",
              admin_shops_path,
              class: "text-sm font-bold text-[#616161] hover:text-black" %>


  <div class="mt-5 flex items-start justify-between gap-6">

    <div>

      <div class="flex items-center gap-3">

        <h1 class="text-2xl font-black tracking-[-0.04em]">
          <%= @shop.name %>
        </h1>

        <span class="rounded-full bg-[#f1f1f1] px-3 py-1 text-xs font-black text-[#616161]">
          <%= @shop.status %>
        </span>

      </div>


      <p class="mt-2 font-mono text-sm text-[#008060]">
        /store/<%= @shop.slug %>
      </p>

    </div>


    <%= link_to "Редактировать",
                edit_admin_shop_path(@shop),
                class: "inline-flex h-10 items-center rounded-xl border border-black/10 bg-white px-4 text-sm font-black hover:bg-[#f7f7f7]" %>

  </div>


  <div class="mt-7 grid gap-5 lg:grid-cols-3">

    <div class="rounded-2xl border border-black/10 bg-white p-5">

      <p class="text-xs font-black uppercase tracking-[0.1em] text-[#8a8a8a]">
        Товары
      </p>

      <p class="mt-4 text-2xl font-black">
        0
      </p>

    </div>


    <div class="rounded-2xl border border-black/10 bg-white p-5">

      <p class="text-xs font-black uppercase tracking-[0.1em] text-[#8a8a8a]">
        Заказы
      </p>

      <p class="mt-4 text-2xl font-black">
        0
      </p>

    </div>


    <div class="rounded-2xl border border-black/10 bg-white p-5">

      <p class="text-xs font-black uppercase tracking-[0.1em] text-[#8a8a8a]">
        Продажи
      </p>

      <p class="mt-4 text-2xl font-black">
        0 ₸
      </p>

    </div>

  </div>


  <section class="mt-5 rounded-2xl border border-black/10 bg-white p-6">

    <h2 class="font-black">
      Интернет-магазин
    </h2>

    <p class="mt-1 text-sm text-[#8a8a8a]">
      Публичная витрина магазина.
    </p>


    <div class="mt-5 flex flex-wrap gap-3">

      <button
        type="button"
        disabled
        class="rounded-xl border border-black/10 px-4 py-2.5 text-sm font-black text-[#8a8a8a]"
      >
        Настроить витрину
      </button>


      <% if @shop.active? %>

        <a
          href="/store/<%= @shop.slug %>"
          target="_blank"
          rel="noopener noreferrer"
          class="rounded-xl bg-[#303030] px-4 py-2.5 text-sm font-black text-white"
        >
          Открыть магазин ↗
        </a>

      <% end %>

    </div>

  </section>

</div>