<% content_for :title, "Изменить остаток — Lavkin" %>

<div class="mx-auto max-w-2xl">

  <%= link_to "← Остатки",
              admin_inventory_path(
                location_id: @location.id
              ),
              class: "text-sm font-bold text-[#616161] hover:text-black" %>


  <div class="mt-5">

    <h1 class="text-2xl font-black tracking-[-0.04em]">
      Изменить остаток
    </h1>

    <p class="mt-1 text-sm text-[#616161]">
      <strong class="text-[#303030]">
        <%= @product.name %>
      </strong>
      ·
      <%= @location.name %>
    </p>

  </div>


  <section class="mt-7 rounded-2xl border border-black/10 bg-white p-6">

    <% if @error_message.present? %>

      <div class="mb-5 rounded-xl border border-red-200 bg-red-50 p-4 text-sm font-bold text-red-700">
        <%= @error_message %>
      </div>

    <% end %>


    <div class="mb-6 rounded-xl bg-[#f7f7f7] p-4">

      <p class="text-xs font-bold text-[#8a8a8a]">
        Текущий остаток
      </p>

      <p class="mt-2 text-3xl font-black">
        <%= @inventory_level.quantity || 0 %>
      </p>

    </div>


   <%= form_with url: admin_inventory_adjustments_path,
              method: :post,
              scope: :inventory_adjustment,
              class: "space-y-5" do |form| %>

  <%= hidden_field_tag :product_id, @product.id %>
  <%= hidden_field_tag :location_id, @location.id %>


  <div>
    <%= form.label :quantity,
                   "Новый остаток",
                   class: "block text-sm font-black" %>

    <%= form.number_field :quantity,
                          min: 0,
                          required: true,
                          value: @inventory_level.quantity || 0,
                          class: "
                            mt-2 h-11 w-full
                            rounded-xl border border-black/10
                            bg-white px-4 text-sm
                            outline-none
                            focus:border-[#008060]
                          " %>

    <p class="mt-2 text-xs text-[#8a8a8a]">
      Укажите фактическое количество товара на складе.
    </p>
  </div>


  <div>
    <%= form.label :comment,
                   "Комментарий",
                   class: "block text-sm font-black" %>

    <%= form.text_field :comment,
                        placeholder: "Например: начальный остаток",
                        class: "
                          mt-2 h-11 w-full
                          rounded-xl border border-black/10
                          bg-white px-4 text-sm
                          outline-none
                          focus:border-[#008060]
                        " %>
  </div>


  <div class="flex justify-end gap-3 border-t border-black/10 pt-5">

    <%= link_to "Отмена",
                admin_inventory_path(location_id: @location.id),
                class: "
                  inline-flex h-10 items-center
                  rounded-xl border border-black/10
                  px-4 text-sm font-black
                  hover:bg-[#f7f7f7]
                " %>

    <%= form.submit "Сохранить остаток",
                    class: "
                      h-10 cursor-pointer
                      rounded-xl bg-[#303030]
                      px-5 text-sm font-black
                      text-white hover:bg-black
                    " %>

  </div>

<% end %>

  </section>

</div>