<%= form_with model: [:admin, product],
              class: "space-y-6" do |form| %>

  <% if product.errors.any? %>
    <div class="rounded-xl border border-red-200 bg-red-50 p-4">

      <p class="text-sm font-black text-red-700">
        Проверьте введённые данные
      </p>

      <ul class="mt-2 list-disc space-y-1 pl-5 text-sm text-red-700">
        <% product.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>

    </div>
  <% end %>


  <!-- BASIC INFO -->
  <section class="rounded-2xl border border-black/10 bg-white p-6">

    <h2 class="font-black">
      Основная информация
    </h2>


    <div class="mt-6 space-y-5">

      <div>
        <%= form.label :name,
                       "Название товара",
                       class: "block text-sm font-black" %>

        <%= form.text_field :name,
                            placeholder: "Cappuccino",
                            autofocus: true,
                            class: "mt-2 h-11 w-full rounded-xl border border-black/10 bg-white px-4 text-sm outline-none focus:border-[#008060]" %>
      </div>


      <div>
        <%= form.label :slug,
                       "Адрес товара",
                       class: "block text-sm font-black" %>

        <%= form.text_field :slug,
                            placeholder: "cappuccino",
                            class: "mt-2 h-11 w-full rounded-xl border border-black/10 bg-white px-4 font-mono text-sm outline-none focus:border-[#008060]" %>

        <p class="mt-2 text-xs text-[#8a8a8a]">
          Например: /products/cappuccino
        </p>
      </div>


      <div>
        <%= form.label :description,
                       "Описание",
                       class: "block text-sm font-black" %>

        <p class="mt-1 text-xs text-[#8a8a8a]">
          Добавьте описание товара, характеристики и детали.
        </p>

        <div class="mt-3">
          <%= form.rich_text_area :description,
                                  placeholder: "Расскажите о товаре..." %>
        </div>
      </div>

    </div>

  </section>


  <!-- MEDIA -->
  <section class="rounded-2xl border border-black/10 bg-white p-6">

    <h2 class="font-black">
      Изображение
    </h2>

    <p class="mt-1 text-sm text-[#8a8a8a]">
      Основное изображение товара.
    </p>


    <% if product.image.attached? %>
      <div class="mt-5">

        <%= image_tag product.image,
                      class: "size-28 rounded-xl object-cover border border-black/10" %>

      </div>
    <% end %>


    <div class="mt-5">
      <%= form.file_field :image,
                          accept: "image/png,image/jpeg,image/webp",
                          class: "block w-full text-sm" %>
    </div>

  </section>


  <!-- ORGANIZATION -->
  <section class="rounded-2xl border border-black/10 bg-white p-6">

    <h2 class="font-black">
      Организация
    </h2>


    <div class="mt-6 grid gap-5 md:grid-cols-2">

      <div>
        <%= form.label :category_id,
                       "Категория",
                       class: "block text-sm font-black" %>

        <%= form.collection_select :category_id,
                                   Current.shop.categories.ordered,
                                   :id,
                                   :name,
                                   {
                                     include_blank: "Без категории"
                                   },
                                   class: "mt-2 h-11 w-full rounded-xl border border-black/10 bg-white px-3 text-sm outline-none focus:border-[#008060]" %>
      </div>


      <div>
        <%= form.label :sku,
                       "SKU",
                       class: "block text-sm font-black" %>

        <%= form.text_field :sku,
                            placeholder: "CAP-300",
                            class: "mt-2 h-11 w-full rounded-xl border border-black/10 bg-white px-4 font-mono text-sm uppercase outline-none focus:border-[#008060]" %>
      </div>

    </div>

  </section>


  <!-- PRICING -->
  <section class="rounded-2xl border border-black/10 bg-white p-6">

    <h2 class="font-black">
      Цена
    </h2>


    <div class="mt-6 grid gap-5 md:grid-cols-2">

      <div>
        <%= form.label :price,
                       "Цена",
                       class: "block text-sm font-black" %>

        <div class="relative mt-2">

          <%= form.number_field :price,
                                min: 0,
                                step: 0.01,
                                placeholder: "2500",
                                class: "h-11 w-full rounded-xl border border-black/10 bg-white px-4 pr-12 text-sm outline-none focus:border-[#008060]" %>

          <span class="pointer-events-none absolute inset-y-0 right-4 flex items-center text-sm font-bold text-[#8a8a8a]">
            ₸
          </span>

        </div>
      </div>


      <div>
        <%= form.label :compare_at_price,
                       "Цена до скидки",
                       class: "block text-sm font-black" %>

        <div class="relative mt-2">

          <%= form.number_field :compare_at_price,
                                min: 0,
                                step: 0.01,
                                placeholder: "3000",
                                class: "h-11 w-full rounded-xl border border-black/10 bg-white px-4 pr-12 text-sm outline-none focus:border-[#008060]" %>

          <span class="pointer-events-none absolute inset-y-0 right-4 flex items-center text-sm font-bold text-[#8a8a8a]">
            ₸
          </span>

        </div>
      </div>

    </div>

  </section>


  <!-- STATUS -->
  <section class="rounded-2xl border border-black/10 bg-white p-6">

    <h2 class="font-black">
      Публикация
    </h2>


    <div class="mt-5 space-y-3">

      <label class="flex cursor-pointer items-center justify-between rounded-xl border border-black/10 p-4">

        <div>
          <p class="text-sm font-black">
            Активный товар
          </p>

          <p class="mt-1 text-xs text-[#8a8a8a]">
            Товар отображается в интернет-магазине.
          </p>
        </div>

        <%= form.check_box :active,
                           class: "size-5 rounded border-black/20 text-[#008060] focus:ring-[#008060]" %>

      </label>


      <label class="flex cursor-pointer items-center justify-between rounded-xl border border-black/10 p-4">

        <div>
          <p class="text-sm font-black">
            Рекомендуемый
          </p>

          <p class="mt-1 text-xs text-[#8a8a8a]">
            Можно выводить товар в специальных подборках витрины.
          </p>
        </div>

        <%= form.check_box :featured,
                           class: "size-5 rounded border-black/20 text-[#008060] focus:ring-[#008060]" %>

      </label>

    </div>

  </section>


  <!-- ACTIONS -->
  <div class="flex justify-end gap-3">

    <%= link_to "Отмена",
                admin_products_path,
                class: "inline-flex h-10 items-center rounded-xl border border-black/10 bg-white px-4 text-sm font-black hover:bg-[#f7f7f7]" %>

    <%= form.submit(
          product.persisted? ? "Сохранить" : "Создать товар",
          class: "h-10 cursor-pointer rounded-xl bg-[#303030] px-5 text-sm font-black text-white hover:bg-black"
        ) %>

  </div>

<% end %>