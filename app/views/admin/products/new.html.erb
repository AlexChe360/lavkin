<% content_for :title, "Новый товар — Lavkin" %>

<div class="mx-auto max-w-4xl">

  <%= link_to "← Товары",
              admin_products_path,
              class: "text-sm font-bold text-[#616161] hover:text-black" %>

  <div class="mt-5">

    <h1 class="text-2xl font-black tracking-[-0.04em]">
      Новый товар
    </h1>

    <p class="mt-1 text-sm text-[#616161]">
      Добавьте товар в магазин
      <strong class="text-[#303030]">
        <%= Current.shop.name %>
      </strong>.
    </p>

  </div>


  <div class="mt-7">
    <%= render "form",
               product: @product %>
  </div>

</div>