<% content_for :title, "#{@product.name} — Lavkin" %>

<div>

  <%= link_to "← Товары",
              admin_products_path,
              class: "text-sm font-bold text-[#616161] hover:text-black" %>


  <div class="mt-5 flex flex-col gap-5 sm:flex-row sm:items-start sm:justify-between">

  <div>
    <div class="flex flex-wrap items-center gap-3">

      <h1 class="text-3xl font-black tracking-[-0.05em]">
        <%= @product.name %>
      </h1>

      <% if @product.active? %>
        <span class="rounded-full bg-[#e3f1df] px-3 py-1 text-xs font-black text-[#0a5c36]">
          Активен
        </span>
      <% else %>
        <span class="rounded-full bg-[#eeeeee] px-3 py-1 text-xs font-black text-[#616161]">
          Черновик
        </span>
      <% end %>

    </div>

    <p class="mt-2 font-mono text-sm text-[#8a8a8a]">
      <%= @product.sku %>
    </p>
  </div>


  <div class="flex items-center gap-3">

    <%= link_to "Редактировать",
                edit_admin_product_path(@product),
                class: "inline-flex h-10 items-center justify-center rounded-xl bg-[#303030] px-4 text-sm font-black text-white transition hover:bg-black" %>
    <% if Current.membership&.owner? || Current.membership&.admin? %>

      <%= button_to "Удалить",
              admin_product_path(@product),
              method: :delete,
              form: {
                class: "m-0"
              },
              data: {
                action: "click->confirm#open",
                confirm_title: "Удалить товар?",
                confirm_message: "Товар «#{@product.name}» будет удалён. Это действие нельзя отменить.",
                confirm_text: "Удалить",
                confirm_danger: true
              },
              class: "
                inline-flex h-10 items-center
                rounded-xl
                border border-red-200
                bg-white
                px-4
                text-sm font-black
                text-red-600
                hover:bg-red-50
              " %>
    <% end %>  
  </div>

</div>



  <div class="mt-7 grid gap-5 lg:grid-cols-[1fr_320px]">


    <!-- LEFT -->

    <div class="space-y-5">

      <section class="rounded-2xl border border-black/10 bg-white p-6">

          <h2 class="font-black">
            Информация о товаре
          </h2>

          <div class="mt-5 flex items-start gap-6">

            <% if @product.image.attached? %>
              <%= image_tag @product.image,
                            class: "h-40 w-40 shrink-0 rounded-xl border border-black/10 bg-[#f7f7f7] object-contain" %>
            <% else %>
              <div class="flex h-40 w-40 shrink-0 items-center justify-center rounded-xl border border-black/10 bg-[#f7f7f7] text-sm text-[#8a8a8a]">
                Нет изображения
              </div>
            <% end %>

            <div class="min-w-0 flex-1">

              <h3 class="text-lg font-black">
                <%= @product.name %>
              </h3>

              <% if @product.description.present? %>
                <div class="mt-3 text-sm leading-6 text-[#616161]">
                  <%= @product.description %>
                </div>
              <% else %>
                <p class="mt-3 text-sm text-[#8a8a8a]">
                  Описание не добавлено.
                </p>
              <% end %>

            </div>

          </div>

        </section>


      <section class="rounded-2xl border border-black/10 bg-white">

  <div class="flex flex-col gap-4 border-b border-black/10 px-6 py-5 sm:flex-row sm:items-center sm:justify-between">

    <div>

      <h2 class="font-black">
        Склад
      </h2>

      <p class="mt-1 text-sm text-[#8a8a8a]">
        Остатки товара по складам.
      </p>

    </div>

    <%= link_to "История движений",
                admin_inventory_movements_path(q: @product.sku),
                class: "inline-flex h-9 items-center justify-center rounded-lg border border-black/10 bg-white px-3 text-xs font-black transition hover:bg-[#f7f7f7]" %>

  </div>


  <% if @locations.any? %>

    <div class="divide-y divide-black/10">

      <% @locations.each do |location| %>

        <% level = @inventory_levels[location.id] %>
        <% quantity = level&.quantity || 0 %>

        <div class="flex flex-col gap-4 px-6 py-4 sm:flex-row sm:items-center sm:justify-between">

          <div>

            <p class="text-sm font-black">
              <%= location.name %>
            </p>

            <p class="mt-1 font-mono text-xs text-[#8a8a8a]">
              <%= location.code %>
            </p>

          </div>


          <div class="flex items-center gap-4">

            <div class="text-right">

              <p class="text-xs font-bold text-[#8a8a8a]">
                Остаток
              </p>

              <p
                class="
                  mt-1 text-lg font-black
                  <%= quantity.zero? ?
                        "text-red-600" :
                        quantity <= 5 ?
                          "text-amber-600" :
                          "text-[#008060]" %>
                "
              >
                <%= quantity %>
              </p>

            </div>

            <% if Current.membership&.owner? || Current.membership&.admin? %>
              <%= link_to "Изменить",
                        new_admin_inventory_adjustment_path(
                          product_id: @product.id,
                          location_id: location.id
                        ),
                        class: "inline-flex h-9 items-center justify-center rounded-lg border border-black/10 bg-white px-3 text-xs font-black transition hover:bg-[#f7f7f7]" %>
            <% end %>

          </div>

        </div>

      <% end %>

    </div>


    <div class="flex items-center justify-between border-t border-black/10 bg-[#fafafa] px-6 py-4">

      <span class="text-sm font-bold text-[#616161]">
        Общий остаток
      </span>

      <span class="text-lg font-black">
        <%= @inventory_levels.values.sum(&:quantity) %>
      </span>

    </div>

  <% else %>

    <div class="px-6 py-10 text-center">

      <h3 class="font-black">
        Склады не настроены
      </h3>

      <p class="mt-2 text-sm text-[#8a8a8a]">
        Создайте склад, чтобы вести учёт этого товара.
      </p>

    </div>

  <% end %>

</section>

    </div>


    <!-- RIGHT -->

    <aside class="space-y-5">

      <section class="rounded-2xl border border-black/10 bg-white p-5">

        <p class="text-xs font-black uppercase tracking-[0.1em] text-[#8a8a8a]">
          Цена
        </p>

        <p class="mt-3 text-2xl font-black">
          <%= number_to_currency(
                @product.price,
                unit: "₸",
                format: "%n %u",
                delimiter: " ",
                separator: ","
              ) %>
        </p>

      </section>


      <section class="rounded-2xl border border-black/10 bg-white p-5">

        <dl class="space-y-4">

          <div>
            <dt class="text-xs font-bold text-[#8a8a8a]">
              Категория
            </dt>

            <dd class="mt-1 text-sm font-black">
              <%= @product.category&.name || "Без категории" %>
            </dd>
          </div>


          <div>
            <dt class="text-xs font-bold text-[#8a8a8a]">
              SKU
            </dt>

            <dd class="mt-1 font-mono text-sm font-black">
              <%= @product.sku %>
            </dd>
          </div>


          <div>
            <dt class="text-xs font-bold text-[#8a8a8a]">
              Адрес
            </dt>

            <dd class="mt-1 truncate font-mono text-sm text-[#008060]">
              /products/<%= @product.slug %>
            </dd>
          </div>

        </dl>

      </section>

    </aside>

  </div>

</div>