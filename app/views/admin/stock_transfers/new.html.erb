<% content_for :title, "Новое перемещение — Lavkin" %>

<div class="mx-auto max-w-3xl">

  <%= link_to "← Перемещения",
              admin_stock_transfers_path,
              class: "text-sm font-bold text-[#616161] hover:text-black" %>

  <div class="mt-5">

    <h1 class="text-2xl font-black tracking-[-0.04em]">
      Новое перемещение
    </h1>

    <p class="mt-1 text-sm text-[#616161]">
      Переместите товар между складами.
    </p>

  </div>


  <%= form_with model: [:admin, @transfer],
                class: "mt-7 space-y-5" do |form| %>

    <% if @transfer.errors.any? %>
      <div class="rounded-xl border border-red-200 bg-red-50 p-4">
        <% @transfer.errors.full_messages.each do |message| %>
          <p class="text-sm font-bold text-red-700">
            <%= message %>
          </p>
        <% end %>
      </div>
    <% end %>


    <section class="rounded-2xl border border-black/10 bg-white p-6">

      <h2 class="font-black">
        Склады
      </h2>

      <div class="mt-5 grid gap-5 md:grid-cols-2">

        <div>
          <%= form.label :source_location_id,
                         "Откуда",
                         class: "block text-sm font-black" %>

          <%= form.collection_select :source_location_id,
                                     @locations,
                                     :id,
                                     :name,
                                     {
                                       prompt: "Выберите склад"
                                     },
                                     class: "mt-2 h-11 w-full rounded-xl border border-black/10 bg-white px-3 text-sm" %>
        </div>


        <div>
          <%= form.label :destination_location_id,
                         "Куда",
                         class: "block text-sm font-black" %>

          <%= form.collection_select :destination_location_id,
                                     @locations,
                                     :id,
                                     :name,
                                     {
                                       prompt: "Выберите склад"
                                     },
                                     class: "mt-2 h-11 w-full rounded-xl border border-black/10 bg-white px-3 text-sm" %>
        </div>

      </div>

    </section>


    <section class="rounded-2xl border border-black/10 bg-white p-6">

      <h2 class="font-black">
        Товар
      </h2>

      <%= form.fields_for :stock_transfer_items do |item_form| %>

        <div class="mt-5 grid gap-5 md:grid-cols-[1fr_180px]">

          <div>
            <%= item_form.label :product_id,
                                "Товар",
                                class: "block text-sm font-black" %>

            <%= item_form.collection_select :product_id,
                                            @products,
                                            :id,
                                            :name,
                                            {
                                              prompt: "Выберите товар"
                                            },
                                            class: "mt-2 h-11 w-full rounded-xl border border-black/10 bg-white px-3 text-sm" %>
          </div>


          <div>
            <%= item_form.label :quantity,
                                "Количество",
                                class: "block text-sm font-black" %>

            <%= item_form.number_field :quantity,
                                       min: 1,
                                       value: 1,
                                       class: "mt-2 h-11 w-full rounded-xl border border-black/10 bg-white px-4 text-sm" %>
          </div>

        </div>

      <% end %>

    </section>


    <div class="flex justify-end gap-3">

      <%= link_to "Отмена",
                  admin_stock_transfers_path,
                  class: "inline-flex h-10 items-center rounded-xl border border-black/10 px-4 text-sm font-black hover:bg-[#f7f7f7]" %>

      <%= form.submit "Создать перемещение",
                      class: "h-10 cursor-pointer rounded-xl bg-[#303030] px-5 text-sm font-black text-white hover:bg-black" %>

    </div>

  <% end %>

</div>