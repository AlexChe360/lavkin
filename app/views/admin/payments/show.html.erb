<% content_for :title, "Платежи — Lavkin" %>

<div class="mx-auto max-w-5xl">

  <!-- HEADER -->

  <div>

    <p class="
      text-xs font-black uppercase
      tracking-[0.14em]
      text-[#8a8a8a]
    ">
      Финансы
    </p>

    <h1 class="
      mt-2 text-3xl font-black
      tracking-[-0.05em]
    ">
      Платежи
    </h1>

    <p class="mt-2 text-sm text-[#616161]">
      Подключайте платёжные сервисы и управляйте онлайн-оплатой.
    </p>

  </div>


  <!-- PROVIDERS -->

  <div class="mt-7 space-y-5">

    <!-- FREEDOM PAY -->

    <section class="
      rounded-2xl
      border border-black/10
      bg-white
      p-6
    ">

      <div class="
        flex flex-col gap-5
        sm:flex-row
        sm:items-start
        sm:justify-between
      ">

        <div class="flex items-start gap-4">

          <!-- LOGO -->

          <div class="
            flex size-12 shrink-0
            items-center justify-center
            rounded-xl
            bg-[#303030]
            text-sm font-black text-white
          ">
            FP
          </div>


          <div>

            <h2 class="text-lg font-black">
              Freedom Pay
            </h2>

            <p class="mt-1 max-w-xl text-sm leading-6 text-[#8a8a8a]">
              Принимайте онлайн-платежи банковскими картами
              через интернет-магазин Lavkin.
            </p>

          </div>

        </div>


        <% if @freedom_pay&.connected? %>

          <span class="
            inline-flex w-fit items-center
            rounded-full
            bg-green-50
            px-3 py-1
            text-xs font-black
            text-green-700
          ">
            Подключено
          </span>

        <% elsif @freedom_pay&.pending? %>

          <span class="
            inline-flex w-fit items-center
            rounded-full
            bg-amber-50
            px-3 py-1
            text-xs font-black
            text-amber-700
          ">
            На рассмотрении
          </span>

        <% else %>

          <span class="
            inline-flex w-fit items-center
            rounded-full
            bg-[#eeeeee]
            px-3 py-1
            text-xs font-black
            text-[#616161]
          ">
            Не подключено
          </span>

        <% end %>

      </div>


      <!-- LEGAL STATUS -->

      <div class="
        mt-6
        rounded-xl
        border border-black/10
        bg-[#f7f7f7]
        p-5
      ">

        <div class="
          flex flex-col gap-4
          sm:flex-row
          sm:items-center
          sm:justify-between
        ">

          <div>

            <p class="text-sm font-black">
              Юридические данные
            </p>


            <% if @legal_profile&.complete_for_payments? %>

              <p class="mt-1 text-sm text-green-700">
                Все необходимые данные заполнены.
              </p>

            <% else %>

              <p class="mt-1 text-sm text-[#8a8a8a]">
                Для подключения платёжного сервиса заполните
                юридические данные бизнеса.
              </p>

            <% end %>

          </div>


          <% unless @legal_profile&.complete_for_payments? %>

            <%= link_to "Заполнить данные",
                        admin_business_settings_path(anchor: "legal"),
                        class: "
                          inline-flex h-10 items-center
                          justify-center
                          rounded-xl
                          border border-black/10
                          bg-white
                          px-4
                          text-sm font-black
                          transition
                          hover:bg-[#eeeeee]
                        " %>

          <% end %>

        </div>

      </div>


      <!-- PROVIDER INFO -->

      <% if @freedom_pay.present? %>

        <div class="
          mt-5 grid gap-4
          rounded-xl
          border border-black/10
          p-5
          sm:grid-cols-2
        ">

          <div>

            <p class="
              text-xs font-bold uppercase
              tracking-[0.1em]
              text-[#8a8a8a]
            ">
              Статус
            </p>

            <p class="mt-1 text-sm font-black">
              <%= @freedom_pay.status_name %>
            </p>

          </div>


          <% if @freedom_pay.merchant_id.present? %>

            <div>

              <p class="
                text-xs font-bold uppercase
                tracking-[0.1em]
                text-[#8a8a8a]
              ">
                Merchant ID
              </p>

              <p class="mt-1 font-mono text-sm font-bold">
                <%= @freedom_pay.merchant_id %>
              </p>

            </div>

          <% end %>


          <% if @freedom_pay.terminal_number.present? %>

            <div>

              <p class="
                text-xs font-bold uppercase
                tracking-[0.1em]
                text-[#8a8a8a]
              ">
                Терминал
              </p>

              <p class="mt-1 font-mono text-sm font-bold">
                <%= @freedom_pay.terminal_number %>
              </p>

            </div>

          <% end %>


          <% if @freedom_pay.connected_at.present? %>

            <div>

              <p class="
                text-xs font-bold uppercase
                tracking-[0.1em]
                text-[#8a8a8a]
              ">
                Подключено
              </p>

              <p class="mt-1 text-sm font-black">
                <%= l @freedom_pay.connected_at,
                      format: :short %>
              </p>

            </div>

          <% end %>

        </div>

      <% end %>


      <!-- ACTION -->

      <div class="
        mt-6 flex items-center
        justify-end
        border-t border-black/10
        pt-5
      ">

        <% if @freedom_pay&.connected? %>

          <button
            type="button"
            disabled
            class="
              h-10 cursor-not-allowed
              rounded-xl
              border border-black/10
              bg-[#f7f7f7]
              px-4
              text-sm font-black
              text-[#8a8a8a]
            "
          >
            Freedom Pay подключён
          </button>


        <% elsif @freedom_pay&.pending? %>

          <button
            type="button"
            disabled
            class="
              h-10 cursor-not-allowed
              rounded-xl
              border border-black/10
              bg-[#f7f7f7]
              px-4
              text-sm font-black
              text-[#8a8a8a]
            "
          >
            Заявка рассматривается
          </button>


        <% elsif @legal_profile&.complete_for_payments? %>

          <%= button_to "Подключить Freedom Pay",
                        connect_freedom_pay_admin_payments_path,
                        method: :post,
                        class: "
                          h-10
                          rounded-xl
                          bg-[#303030]
                          px-5
                          text-sm font-black
                          text-white
                          transition
                          hover:bg-black
                        " %>


        <% else %>

          <button
            type="button"
            disabled
            class="
              h-10 cursor-not-allowed
              rounded-xl
              bg-[#303030]
              px-5
              text-sm font-black
              text-white
              opacity-40
            "
          >
            Подключить Freedom Pay
          </button>

        <% end %>

      </div>

    </section>

  </div>

</div>