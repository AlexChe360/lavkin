<% content_for :title, "Сотрудники — Lavkin" %>

<div>

  <div class="flex items-start justify-between gap-6">

  <div>
    <h1 class="text-2xl font-black tracking-[-0.04em]">
      Сотрудники
    </h1>

    <p class="mt-1 text-sm text-[#616161]">
      Управляйте доступом к
      <strong class="text-[#303030]">
        <%= Current.account.name %>
      </strong>.
    </p>
  </div>


  <%= link_to "+ Пригласить сотрудника",
              new_admin_member_invitation_path,
              class: "inline-flex h-10 items-center rounded-xl bg-[#303030] px-4 text-sm font-black text-white hover:bg-black" %>

  </div>


  <section class="mt-7 overflow-hidden rounded-2xl border border-black/10 bg-white">

    <div class="divide-y divide-black/10">

      <% @memberships.each do |membership| %>

        <div class="flex items-center justify-between gap-6 px-5 py-4">

          <div>

            <p class="text-sm font-black">
              <%= membership.user.email_address %>
            </p>

            <% if membership.user == Current.user %>
              <p class="mt-1 text-xs text-[#8a8a8a]">
                Это вы
              </p>
            <% end %>

          </div>


          <div class="flex items-center gap-5">

            <span class="
              rounded-full
              bg-[#eeeeee]
              px-3 py-1
              text-xs font-black
              text-[#616161]
            ">
              <%= membership.role_name %>
            </span>


            <% unless membership.owner? %>

              <%= link_to "Изменить",
                          edit_admin_member_path(membership),
                          class: "text-sm font-bold text-[#616161] hover:text-black" %>

            <% end %>

          </div>

        </div>

      <% end %>

    </div>

  </section>

</div>