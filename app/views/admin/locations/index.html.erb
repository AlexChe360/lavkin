<% content_for :title, "Склады — Lavkin" %>

<div>

  <div class="flex items-start justify-between gap-6">

    <div>

      <h1 class="text-2xl font-black tracking-[-0.04em]">
        Склады
      </h1>

      <p class="mt-1 text-sm text-[#616161]">
        Управляйте складами и торговыми точками магазина
        <strong class="text-[#303030]">
          <%= Current.shop.name %>
        </strong>.
      </p>

    </div>

    <% if Current.membership&.owner? ||
          Current.membership&.admin? %>

      <%= link_to "+ Добавить склад",
                new_admin_location_path,
                class: "
                  inline-flex h-10 items-center
                  rounded-xl bg-[#303030]
                  px-4 text-sm font-black
                  text-white hover:bg-black
                " %>
    <% end %>

  </div>


  <section class="mt-7 overflow-hidden rounded-2xl border border-black/10 bg-white">

    <% if @locations.any? %>

      <div class="divide-y divide-black/10">

        <% @locations.each do |location| %>

          <div class="flex items-center justify-between gap-6 px-5 py-4">

            <div>

              <div class="flex items-center gap-3">

                <p class="text-sm font-black">
                  <%= location.name %>
                </p>

                <% if location.active? %>

                  <span class="
                    rounded-full
                    bg-[#e3f1df]
                    px-2.5 py-1
                    text-[11px] font-black
                    text-[#0a5c36]
                  ">
                    Активен
                  </span>

                <% else %>

                  <span class="
                    rounded-full
                    bg-[#eeeeee]
                    px-2.5 py-1
                    text-[11px] font-black
                    text-[#616161]
                  ">
                    Неактивен
                  </span>

                <% end %>

              </div>

              <p class="mt-1 font-mono text-xs text-[#8a8a8a]">
                <%= location.code %>
              </p>

            </div>


            <div class="flex items-center gap-5">

              <div class="text-right">

                <p class="text-xs text-[#8a8a8a]">
                  Остаток
                </p>

                <p class="mt-1 text-sm font-black">
                  <%= location.inventory_levels.sum(:quantity) %>
                </p>

              </div>

              <% if Current.membership&.owner? ||
                Current.membership&.admin? %>

                <%= link_to "Редактировать",
                          edit_admin_location_path(location),
                          class: "
                            text-sm font-bold
                            text-[#616161]
                            hover:text-black
                          " %>
              <% end %>

            </div>

          </div>

        <% end %>

      </div>

    <% else %>

      <div class="px-6 py-16 text-center">

        <h2 class="font-black">
          Склады ещё не созданы
        </h2>

        <p class="mt-2 text-sm text-[#8a8a8a]">
          Создайте первый склад для учёта товаров.
        </p>

        <% if Current.membership&.owner? ||
          Current.membership&.admin? %>

          <%= link_to "Создать склад",
                    new_admin_location_path,
                    class: "
                      mt-5 inline-flex h-10
                      items-center rounded-xl
                      bg-[#303030]
                      px-4 text-sm font-black
                      text-white
                    " %>

        <% end %>

      </div>

    <% end %>

  </section>

</div>