<% content_for :title, "Редактирование склада — Lavkin" %>

<div class="mx-auto max-w-2xl">

  <%= link_to "← Склады",
              admin_locations_path,
              class: "text-sm font-bold text-[#616161] hover:text-black" %>

  <div class="mt-5">

    <h1 class="text-2xl font-black tracking-[-0.04em]">
      Редактирование склада
    </h1>

    <p class="mt-1 text-sm text-[#616161]">
      <%= @location.name %>
    </p>

  </div>


  <div class="mt-7 rounded-2xl border border-black/10 bg-white p-6">
    <%= render "form",
               location: @location %>
  </div>


  <% unless @location.inventory_movements.exists? %>

    <section class="mt-6 rounded-2xl border border-red-200 bg-white p-6">

      <h2 class="font-black text-red-700">
        Опасная зона
      </h2>

      <p class="mt-2 text-sm text-[#616161]">
        Удалить можно только склад без истории движений.
      </p>

      <%= button_to "Удалить склад",
                    admin_location_path(@location),
                    method: :delete,
                    form: {
                      class: "mt-5",
                      data: {
                        turbo_confirm: "Удалить склад «#{@location.name}»?"
                      }
                    },
                    class: "
                      h-10 rounded-xl
                      bg-red-600 px-4
                      text-sm font-black
                      text-white hover:bg-red-700
                    " %>

    </section>

  <% end %>

</div>