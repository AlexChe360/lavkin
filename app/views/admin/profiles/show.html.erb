<% content_for :title, "Мой профиль — Lavkin" %>

<div class="mx-auto max-w-3xl">

  <div class="flex items-start justify-between gap-5">

    <div>
      <h1 class="text-2xl font-black tracking-[-0.04em]">
        Мой профиль
      </h1>

      <p class="mt-1 text-sm text-[#616161]">
        Управляйте личными данными вашего аккаунта.
      </p>
    </div>

    <%= link_to "Редактировать",
                edit_admin_profile_path,
                class: "inline-flex h-10 items-center rounded-xl bg-[#303030] px-4 text-sm font-black text-white hover:bg-black" %>

  </div>


  <section class="mt-7 rounded-2xl border border-black/10 bg-white p-6">

    <div class="flex items-center gap-4">

      <div class="flex size-14 items-center justify-center rounded-full bg-[#eeeeee] text-lg font-black">
        <%= @user.email_address.first.upcase %>
      </div>

      <div>
        <p class="text-lg font-black">
          <%= @user.name.presence || "Без имени" %>
        </p>

        <p class="mt-1 text-sm text-[#8a8a8a]">
          <%= @user.email_address %>
        </p>
      </div>

    </div>


    <dl class="mt-7 divide-y divide-black/10">

      <div class="grid gap-2 py-4 sm:grid-cols-[180px_1fr]">
        <dt class="text-sm font-bold text-[#8a8a8a]">
          Имя
        </dt>

        <dd class="text-sm font-black">
          <%= @user.name.presence || "—" %>
        </dd>
      </div>


      <div class="grid gap-2 py-4 sm:grid-cols-[180px_1fr]">
        <dt class="text-sm font-bold text-[#8a8a8a]">
          Email
        </dt>

        <dd class="text-sm font-black">
          <%= @user.email_address %>
        </dd>
      </div>


      <div class="grid gap-2 py-4 sm:grid-cols-[180px_1fr]">
        <dt class="text-sm font-bold text-[#8a8a8a]">
          Телефон
        </dt>

        <dd class="text-sm font-black">
          <%= @user.phone.presence || "—" %>
        </dd>
      </div>


      <div class="grid gap-2 py-4 sm:grid-cols-[180px_1fr]">
        <dt class="text-sm font-bold text-[#8a8a8a]">
          Роль
        </dt>

        <dd class="text-sm font-black">
          <%= {
                "owner" => "Владелец",
                "admin" => "Администратор",
                "manager" => "Менеджер",
                "staff" => "Сотрудник"
              }.fetch(Current.membership&.role, "—") %>
        </dd>
      </div>

    </dl>

  </section>


  <section class="mt-5 rounded-2xl border border-black/10 bg-white p-6">

    <h2 class="font-black">
      Безопасность
    </h2>

    <p class="mt-1 text-sm text-[#8a8a8a]">
      Измените пароль вашего аккаунта.
    </p>

    <%= link_to "Изменить пароль",
                edit_admin_account_password_path,
                class: "mt-5 inline-flex h-10 items-center rounded-xl border border-black/10 bg-white px-4 text-sm font-black hover:bg-[#f7f7f7]" %>

  </section>

</div>