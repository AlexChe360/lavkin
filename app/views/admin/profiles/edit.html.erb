<% content_for :title, "Редактировать профиль — Lavkin" %>

<div class="mx-auto max-w-2xl">

  <%= link_to "← Мой профиль",
              admin_profile_path,
              class: "text-sm font-bold text-[#616161] hover:text-black" %>

  <div class="mt-5">
    <h1 class="text-2xl font-black tracking-[-0.04em]">
      Редактировать профиль
    </h1>

    <p class="mt-1 text-sm text-[#616161]">
      Обновите ваши личные данные.
    </p>
  </div>


  <section class="mt-7 rounded-2xl border border-black/10 bg-white p-6">

    <%= form_with model: @user,
                  url: admin_profile_path,
                  method: :patch,
                  class: "space-y-5" do |form| %>

      <% if @user.errors.any? %>
        <div class="rounded-xl border border-red-200 bg-red-50 p-4">

          <% @user.errors.full_messages.each do |message| %>
            <p class="text-sm font-bold text-red-700">
              <%= message %>
            </p>
          <% end %>

        </div>
      <% end %>


      <div>
        <%= form.label :name,
                       "Имя",
                       class: "block text-sm font-black" %>

        <%= form.text_field :name,
                            placeholder: "Алексей",
                            class: "mt-2 h-11 w-full rounded-xl border border-black/10 px-4 text-sm outline-none focus:border-[#008060]" %>
      </div>


      <div>
        <%= form.label :phone,
                       "Телефон",
                       class: "block text-sm font-black" %>

        <%= form.telephone_field :phone,
                                 placeholder: "+7 (___) ___-__-__",
                                 inputmode: "tel",
                                 autocomplete: "tel",
                                 data: {
                                    controller: "phone-mask",
                                    action: "input->phone-mask#format"
                                },
                                 class: "mt-2 h-11 w-full rounded-xl border border-black/10 px-4 text-sm outline-none focus:border-[#008060]" %>
      </div>


      <div>
        <label class="block text-sm font-black">
          Email
        </label>

        <input
          value="<%= @user.email_address %>"
          disabled
          class="mt-2 h-11 w-full rounded-xl border border-black/10 bg-[#f7f7f7] px-4 text-sm text-[#8a8a8a]"
        >

        <p class="mt-2 text-xs text-[#8a8a8a]">
          Email пока нельзя изменить здесь.
        </p>
      </div>


      <div class="flex justify-end gap-3 border-t border-black/10 pt-5">

        <%= link_to "Отмена",
                    admin_profile_path,
                    class: "inline-flex h-10 items-center rounded-xl border border-black/10 px-4 text-sm font-black hover:bg-[#f7f7f7]" %>

        <%= form.submit "Сохранить",
                        class: "h-10 cursor-pointer rounded-xl bg-[#303030] px-5 text-sm font-black text-white hover:bg-black" %>

      </div>

    <% end %>

  </section>

</div>