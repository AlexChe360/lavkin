<% content_for :title, "Инвентаризации — Lavkin" %>

<div>

  <div class="flex items-start justify-between gap-6">

    <div>
      <h1 class="text-2xl font-black tracking-[-0.04em]">
        Инвентаризации
      </h1>

      <p class="mt-1 text-sm text-[#616161]">
        Пересчёт фактических остатков по складам.
      </p>
    </div>

    <%= link_to "+ Новая инвентаризация",
                new_admin_inventory_count_path,
                class: "inline-flex h-10 items-center rounded-xl bg-[#303030] px-4 text-sm font-black text-white hover:bg-black" %>

  </div>


  <section class="mt-7 overflow-hidden rounded-2xl border border-black/10 bg-white">

    <% if @inventory_counts.any? %>

      <table class="w-full">

        <thead class="bg-[#f7f7f7]">

          <tr class="border-b border-black/10">

            <th class="px-4 py-3 text-left text-xs font-black text-[#8a8a8a]">
              Номер
            </th>

            <th class="px-4 py-3 text-left text-xs font-black text-[#8a8a8a]">
              Склад
            </th>

            <th class="px-4 py-3 text-left text-xs font-black text-[#8a8a8a]">
              Дата
            </th>

            <th class="px-4 py-3 text-left text-xs font-black text-[#8a8a8a]">
              Статус
            </th>

          </tr>

        </thead>


        <tbody class="divide-y divide-black/10">

          <% @inventory_counts.each do |count| %>

            <tr class="hover:bg-[#fafafa]">

              <td class="px-4 py-4">

                <%= link_to count.number,
                            admin_inventory_count_path(count),
                            class: "text-sm font-black hover:underline" %>

              </td>

              <td class="px-4 py-4 text-sm">
                <%= count.location.name %>
              </td>

              <td class="px-4 py-4 text-sm text-[#616161]">
                <%= count.created_at.strftime("%d.%m.%Y %H:%M") %>
              </td>

              <td class="px-4 py-4">

                <% case count.status %>
                <% when "draft" %>
                  <span class="rounded-full bg-[#eeeeee] px-3 py-1 text-xs font-black text-[#616161]">
                    Черновик
                  </span>

                <% when "counting" %>
                  <span class="rounded-full bg-amber-50 px-3 py-1 text-xs font-black text-amber-700">
                    Идёт подсчёт
                  </span>

                <% when "completed" %>
                  <span class="rounded-full bg-[#e3f1df] px-3 py-1 text-xs font-black text-[#0a5c36]">
                    Завершена
                  </span>
                <% end %>

              </td>

            </tr>

          <% end %>

        </tbody>

      </table>

    <% else %>

      <div class="px-6 py-16 text-center">

        <h2 class="font-black">
          Инвентаризаций пока нет
        </h2>

        <p class="mt-2 text-sm text-[#8a8a8a]">
          Создайте первую инвентаризацию склада.
        </p>

      </div>

    <% end %>

  </section>

</div>