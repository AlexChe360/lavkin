<% content_for :title, "Новая инвентаризация — Lavkin" %>

<div class="mx-auto max-w-2xl">

  <%= link_to "← Инвентаризации",
              admin_inventory_counts_path,
              class: "text-sm font-bold text-[#616161] hover:text-black" %>


  <div class="mt-5">

    <h1 class="text-2xl font-black tracking-[-0.04em]">
      Новая инвентаризация
    </h1>

    <p class="mt-1 text-sm text-[#616161]">
      Выберите склад для пересчёта.
    </p>

  </div>


  <section class="mt-7 rounded-2xl border border-black/10 bg-white p-6">

    <%= form_with model: [:admin, @inventory_count],
                  class: "space-y-6" do |form| %>

      <div>

        <%= form.label :location_id,
                       "Склад",
                       class: "block text-sm font-black" %>

        <%= form.collection_select :location_id,
                                   @locations,
                                   :id,
                                   :name,
                                   {
                                     prompt: "Выберите склад"
                                   },
                                   class: "mt-2 h-11 w-full rounded-xl border border-black/10 bg-white px-3 text-sm" %>

      </div>


      <div class="flex justify-end gap-3">

        <%= link_to "Отмена",
                    admin_inventory_counts_path,
                    class: "inline-flex h-10 items-center rounded-xl border border-black/10 px-4 text-sm font-black hover:bg-[#f7f7f7]" %>

        <%= form.submit "Создать",
                        class: "h-10 cursor-pointer rounded-xl bg-[#303030] px-5 text-sm font-black text-white hover:bg-black" %>

      </div>

    <% end %>

  </section>

</div>