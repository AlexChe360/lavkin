<% content_for :title, "#{@order.number} — Lavkin" %>

<div>

  <%= link_to "← Заказы",
              admin_orders_path,
              class: "text-sm font-bold text-[#616161] hover:text-black" %>


  <div class="mt-5 flex flex-col gap-5 sm:flex-row sm:items-start sm:justify-between">

  <div>

    <div class="flex flex-wrap items-center gap-3">

      <h1 class="text-3xl font-black tracking-[-0.05em]">
        <%= @order.number %>
      </h1>


      <% if @order.status == "awaiting_payment" %>

        <span class="rounded-full bg-amber-50 px-3 py-1 text-xs font-black text-amber-700">
          Ожидает оплату
        </span>

      <% elsif @order.status == "paid" %>

        <span class="rounded-full bg-[#e3f1df] px-3 py-1 text-xs font-black text-[#0a5c36]">
          Оплачен
        </span>

      <% elsif @order.status == "processing" %>

        <span class="rounded-full bg-blue-50 px-3 py-1 text-xs font-black text-blue-700">
          В обработке
        </span>

      <% elsif @order.status == "ready" %>

        <span class="rounded-full bg-violet-50 px-3 py-1 text-xs font-black text-violet-700">
          Готов
        </span>

      <% elsif @order.status == "completed" %>

        <span class="rounded-full bg-[#eeeeee] px-3 py-1 text-xs font-black text-[#616161]">
          Завершён
        </span>

      <% elsif @order.status == "cancelled" %>

        <span class="rounded-full bg-red-50 px-3 py-1 text-xs font-black text-red-700">
          Отменён
        </span>

      <% end %>

    </div>


    <p class="mt-2 text-sm text-[#8a8a8a]">
      <%= @order.created_at.strftime("%d.%m.%Y %H:%M") %>
    </p>

  </div>

 <!-- ACTIONS -->

<div class="flex items-center gap-3">

  <% unless %w[completed cancelled].include?(@order.status) %>

    <%= button_to "Отменить заказ",
                  cancel_admin_order_path(@order),
                  method: :post,
                  data: {
                    action: "click->confirm#open",
                    confirm_title: "Отменить заказ?",
                    confirm_message: @order.inventory_committed? ?
                      "Заказ будет отменён, а списанные товары будут возвращены на склад." :
                      "Заказ будет отменён.",
                    confirm_text: "Отменить заказ",
                    confirm_danger: true
                  },
                  class: "h-10 rounded-xl border border-red-200 bg-white px-4 text-sm font-black text-red-600 transition hover:bg-red-50" %>

    <% end %>

    <% if @order.status == "paid" %>

      <%= button_to "Взять в работу",
                    change_status_admin_order_path(@order),
                    method: :patch,
                    params: {
                      status: "processing"
                    },
                    class: "h-10 rounded-xl bg-[#303030] px-4 text-sm font-black text-white hover:bg-black" %>


    <% elsif @order.status == "processing" %>

      <%= button_to "Заказ готов",
                    change_status_admin_order_path(@order),
                    method: :patch,
                    params: {
                      status: "ready"
                    },
                    class: "h-10 rounded-xl bg-[#303030] px-4 text-sm font-black text-white hover:bg-black" %>


    <% elsif @order.status == "ready" %>

      <%= button_to "Завершить заказ",
                    change_status_admin_order_path(@order),
                    method: :patch,
                    params: {
                      status: "completed"
                    },
                    class: "h-10 rounded-xl bg-[#008060] px-4 text-sm font-black text-white hover:bg-[#006e52]" %>

    <% end %>

  </div>

</div>


  <div class="mt-7 grid gap-5 lg:grid-cols-[1fr_340px]">

    <!-- LEFT -->

    <div class="space-y-5">

      <section class="overflow-hidden rounded-2xl border border-black/10 bg-white">

        <div class="border-b border-black/10 px-6 py-5">
          <h2 class="font-black">
            Товары
          </h2>
        </div>


        <div class="divide-y divide-black/10">

          <% @order.order_items.each do |item| %>

            <div class="flex items-center justify-between gap-5 px-6 py-4">

              <div>

                <p class="text-sm font-black">
                  <%= item.product_name %>
                </p>

                <p class="mt-1 font-mono text-xs text-[#8a8a8a]">
                  <%= item.sku %>
                </p>

              </div>


              <div class="flex items-center gap-8">

                <div class="text-right">

                  <p class="text-xs text-[#8a8a8a]">
                    <%= item.quantity %> ×
                    <%= number_to_currency(
                          item.price,
                          unit: "₸",
                          format: "%n %u",
                          delimiter: " ",
                          separator: ","
                        ) %>
                  </p>

                </div>


                <p class="min-w-[100px] text-right text-sm font-black">
                  <%= number_to_currency(
                        item.total_amount,
                        unit: "₸",
                        format: "%n %u",
                        delimiter: " ",
                        separator: ","
                      ) %>
                </p>

              </div>

            </div>

          <% end %>

        </div>


        <div class="flex items-center justify-between border-t border-black/10 bg-[#fafafa] px-6 py-5">

          <span class="font-black">
            Итого
          </span>

          <span class="text-xl font-black">
            <%= number_to_currency(
                  @order.total_amount,
                  unit: "₸",
                  format: "%n %u",
                  delimiter: " ",
                  separator: ","
                ) %>
          </span>

        </div>

      </section>


      <section class="rounded-2xl border border-black/10 bg-white p-6">

        <h2 class="font-black">
          Оплата
        </h2>

        <div class="mt-5 rounded-xl bg-[#f7f7f7] p-4">

          <% if @order.inventory_committed? %>

            <p class="text-sm font-black text-[#008060]">
              Заказ оплачен
            </p>

            <p class="mt-1 text-sm text-[#8a8a8a]">
              Товары списаны со склада.
            </p>

          <% elsif @order.status == "awaiting_payment" %>

            <p class="text-sm font-black">
              Ожидает оплату
            </p>

            <p class="mt-1 text-sm text-[#8a8a8a]">
              FreedomPay пока не подключён, поэтому оплату можно подтвердить вручную.
            </p>

            <%= button_to "Отметить как оплаченный",
                          mark_as_paid_admin_order_path(@order),
                          method: :post,
                          data: {
                            action: "click->confirm#open",
                            confirm_title: "Подтвердить оплату?",
                            confirm_message: "Заказ #{@order.number} будет отмечен как оплаченный, а товары будут списаны со склада.",
                            confirm_text: "Подтвердить оплату",
                            confirm_danger: false
                          },
                          class: "mt-5 h-10 rounded-xl bg-[#008060] px-4 text-sm font-black text-white" %>

          <% else %>

            <p class="text-sm text-[#8a8a8a]">
              Оплата не подтверждена.
            </p>

          <% end %>

        </div>

      </section>

    </div>


    <!-- RIGHT -->

    <aside class="space-y-5">

      <section class="rounded-2xl border border-black/10 bg-white p-5">

        <h2 class="font-black">
          Клиент
        </h2>

        <dl class="mt-5 space-y-4">

          <div>
            <dt class="text-xs font-bold text-[#8a8a8a]">
              Имя
            </dt>

            <dd class="mt-1 text-sm font-black">
              <%= @order.customer_name.presence || "—" %>
            </dd>
          </div>


          <div>
            <dt class="text-xs font-bold text-[#8a8a8a]">
              Телефон
            </dt>

            <dd class="mt-1 text-sm font-black">
              <%= @order.customer_phone.presence || "—" %>
            </dd>
          </div>


          <div>
            <dt class="text-xs font-bold text-[#8a8a8a]">
              Email
            </dt>

            <dd class="mt-1 break-all text-sm font-black">
              <%= @order.customer_email.presence || "—" %>
            </dd>
          </div>

        </dl>

      </section>


      <section class="rounded-2xl border border-black/10 bg-white p-5">

        <h2 class="font-black">
          Заказ
        </h2>

        <dl class="mt-5 space-y-4">

          <div>
            <dt class="text-xs font-bold text-[#8a8a8a]">
              Номер
            </dt>

            <dd class="mt-1 font-mono text-sm font-black">
              <%= @order.number %>
            </dd>
          </div>


          <div>
            <dt class="text-xs font-bold text-[#8a8a8a]">
              Создан
            </dt>

            <dd class="mt-1 text-sm font-black">
              <%= @order.created_at.strftime("%d.%m.%Y %H:%M") %>
            </dd>
          </div>


          <div>
            <dt class="text-xs font-bold text-[#8a8a8a]">
              Сумма
            </dt>

            <dd class="mt-1 text-lg font-black">
              <%= number_to_currency(
                    @order.total_amount,
                    unit: "₸",
                    format: "%n %u",
                    delimiter: " ",
                    separator: ","
                  ) %>
            </dd>
          </div>

        </dl>

      </section>

    </aside>

  </div>

</div>