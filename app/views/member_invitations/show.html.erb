<% content_for :title, "Приглашение — Lavkin" %>

<div class="flex min-h-screen items-center justify-center px-4 py-10">

  <div class="w-full max-w-md">

    <div class="rounded-3xl border border-black/10 bg-white p-8 shadow-sm">

      <div class="flex size-12 items-center justify-center rounded-2xl bg-[#303030] text-xl font-black text-white">
        L
      </div>

      <h1 class="mt-6 text-2xl font-black tracking-[-0.04em]">
        Вас пригласили в команду
      </h1>

      <p class="mt-2 text-sm leading-6 text-[#616161]">
        Вам предоставлен доступ к бизнесу
        <strong class="text-[#303030]">
          <%= @invitation.account.name %>
        </strong>.
      </p>


      <div class="mt-6 rounded-2xl bg-[#f7f7f7] p-5">

        <div>
          <p class="text-xs font-bold text-[#8a8a8a]">
            Email
          </p>

          <p class="mt-1 text-sm font-black">
            <%= @invitation.email %>
          </p>
        </div>

        <div class="mt-4">
          <p class="text-xs font-bold text-[#8a8a8a]">
            Роль
          </p>

          <p class="mt-1 text-sm font-black">
            <%= {
                  "admin" => "Администратор",
                  "manager" => "Менеджер",
                  "staff" => "Сотрудник"
                }.fetch(@invitation.role, @invitation.role) %>
          </p>
        </div>

      </div>


      <% if authenticated? %>

        <% if Current.user.email_address.downcase == @invitation.email.downcase %>

          <%= button_to "Принять приглашение",
                        accept_member_invitation_path(@invitation.token),
                        method: :post,
                        class: "mt-6 h-11 w-full rounded-xl bg-[#303030] text-sm font-black text-white hover:bg-black" %>

        <% else %>

          <div class="mt-6 rounded-xl border border-red-200 bg-red-50 p-4">

            <p class="text-sm font-black text-red-700">
              Вы вошли под другим email
            </p>

            <p class="mt-1 text-xs leading-5 text-red-600">
              Приглашение предназначено для
              <strong><%= @invitation.email %></strong>.
            </p>

          </div>

        <% end %>

      <% else %>

        <p class="mt-6 text-sm leading-6 text-[#616161]">
          Войдите или зарегистрируйтесь с указанным email, чтобы принять приглашение.
        </p>

        <%= button_to "Продолжить",
                      accept_member_invitation_path(@invitation.token),
                      method: :post,
                      class: "mt-4 h-11 w-full rounded-xl bg-[#303030] text-sm font-black text-white hover:bg-black" %>

      <% end %>

    </div>

  </div>

</div>