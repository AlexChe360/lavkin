<% content_for :title, "Восстановление пароля — Lavkin" %>

<div>

  <div>
    <p class="text-sm font-black uppercase tracking-[0.14em] text-[#008060]">
      Восстановление доступа
    </p>

    <h1 class="mt-3 text-4xl font-black tracking-[-0.05em]">
      Забыли пароль?
    </h1>

    <p class="mt-3 text-base leading-7 text-[#616161]">
      Укажите email аккаунта. Мы отправим ссылку для создания нового пароля.
    </p>
  </div>


  <% if alert.present? %>
    <div class="mt-6 rounded-xl border border-red-200 bg-red-50 px-4 py-3 text-sm font-semibold text-red-700">
      <%= alert %>
    </div>
  <% end %>


  <% if notice.present? %>
    <div class="mt-6 rounded-xl border border-emerald-200 bg-emerald-50 px-4 py-3 text-sm font-semibold text-emerald-700">
      <%= notice %>
    </div>
  <% end %>


  <%= form_with url: passwords_path,
                class: "mt-8 space-y-5" do |form| %>

    <div>

      <%= form.label :email_address,
                     "Email",
                     class: "block text-sm font-black text-[#303030]" %>

      <%= form.email_field :email_address,
                           required: true,
                           autofocus: true,
                           autocomplete: "email",
                           placeholder: "you@example.com",
                           value: params[:email_address],
                           class: "mt-2 h-12 w-full rounded-xl border border-black/10 bg-white px-4 text-sm outline-none transition placeholder:text-[#a1a1a1] focus:border-[#008060] focus:ring-2 focus:ring-[#008060]/10" %>

    </div>


    <%= form.submit "Отправить ссылку",
                    class: "h-12 w-full cursor-pointer rounded-xl bg-[#303030] px-5 text-sm font-black text-white transition hover:bg-black" %>

  <% end %>


  <div class="mt-7 border-t border-black/10 pt-6 text-center">

    <%= link_to "← Вернуться ко входу",
                new_session_path,
                class: "text-sm font-black text-[#111111] hover:underline" %>

  </div>

</div>