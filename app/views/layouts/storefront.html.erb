<!DOCTYPE html>
<html lang="ru">

<head>

  <title>
    <%= content_for(:title) || "Lavkin Store" %>
  </title>

  <meta
    name="viewport"
    content="width=device-width,initial-scale=1"
  >

  <%= csrf_meta_tags %>
  <%= csp_meta_tag %>

  <%= favicon_link_tag "lavkin-mark.png" %>

  <%= stylesheet_link_tag "tailwind",
                          "data-turbo-track": "reload" %>

  <%= stylesheet_link_tag "actiontext",
                          "data-turbo-track": "reload" %>

  <%= javascript_importmap_tags %>

</head>

<body class="min-h-screen bg-[#f7f7f7] text-[#111111]">

  <%= yield %>

</body>

</html>