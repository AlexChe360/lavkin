<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "Lavkin" %></title>

    <meta name="viewport" content="width=device-width,initial-scale=1">

    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= stylesheet_link_tag "tailwind", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="min-h-screen bg-[#f5f5f5] text-[#303030]">
    <%= yield %>
  </body>
</html>