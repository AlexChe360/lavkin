<!DOCTYPE html>
<html>
    <head>
        <title><%= content_for(:title) || "Lavkin" %></title>

        <meta name="viewport" content="width=device-width,initial-scale=1">

        <%= csrf_meta_tags %>
        <%= csp_meta_tag %>

        <%= favicon_link_tag "lavkin-mark.png",
              rel: "icon",
              type: "image/png" %>

        <%= stylesheet_link_tag "tailwind", "data-turbo-track": "reload" %>
        <%= javascript_importmap_tags %>
    </head>

    <body class="min-h-screen bg-[#f7f7f7] text-[#111111]">
        
        <div class="grid min-h-screen lg:grid-cols-[1fr_1fr]">
            <!-- LEFT -->
            <div class="hidden bg-[#111111] p-10 text-white lg:flex lg:flex-col lg:justify-between">
                <%= link_to root_path,
                        class: "inline-flex items-center gap-3" do %>

                    <%= image_tag "lavkin-mark-dark.png",
                        alt: "Lavkin",
                        class: "size-10 shrink-0 object-contain" %>

                    <span class="text-xl font-black tracking-[-0.04em]">
                        Lavkin
                    </span>
                <% end %>

                <div class="max-w-xl">

                    <p class="text-sm font-black uppercase tracking-[0.16em] text-[#4fd1aa]">
                        Commerce platform
                    </p>

                    <h1 class="mt-5 text-5xl font-black leading-[1.02] tracking-[-0.06em]">
                        Управление магазином,
                        товаров и продажами
                        в одной системе.
                    </h1>

                    <p class="mt-6 max-w-lg text-lg leading-8 text-white/55">
                        Lavkin объеденяет интернет-магазин, каталог,
                        склад, заказы и аналитику в одном интерфейсе.
                    </p>
                </div>

                <p class="text-sm text-white/30">
                    © <%= Time.current.year %> Lavkin
                </p>
            </div>

            <!-- RIGHT -->
            <div class="flex min-h-screen items-center justify-center px-5 py-10 sm:px-8">
                <div class="w-full max-w[460px]">
                    <div class="mb-8 flex items-center justify-between lg:hidden">

                        <%= link_to root_path,
                                class: "inline-flex items-center gap-3" do %>
                            
                            <%= image_tag "lavkin-mark.png",
                                alt: "Lavkin",
                                class: "size-10 shrink-0 object-contain" %>
                            
                            <span class="text-xl font-black">
                                Lavkin
                            </span>

                        <% end %>
                    </div>

                    <%= yield %>
                </div>
            </div>
        </div>
    </body>
</html>