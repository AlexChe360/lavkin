<dialog
  data-confirm-target="dialog"
  data-action="click->confirm#backdrop"
  class="
    fixed
    left-1/2 top-1/2
    m-0
    w-[calc(100%-32px)]
    max-w-md
    -translate-x-1/2
    -translate-y-1/2
    rounded-2xl
    border border-black/10
    bg-white
    p-0
    shadow-2xl
    backdrop:bg-black/40
  "
>
  <div class="p-6">

    <h2
      data-confirm-target="title"
      class="text-lg font-black tracking-[-0.03em]"
    ></h2>

    <p
      data-confirm-target="message"
      class="mt-2 text-sm leading-6 text-[#616161]"
    ></p>

    <div class="mt-6 flex justify-end gap-3">

      <button
        type="button"
        data-action="confirm#close"
        class="inline-flex h-10 items-center rounded-xl border border-black/10 px-4 text-sm font-black hover:bg-[#f7f7f7]"
      >
        Отмена
      </button>

      <button
        type="button"
        data-confirm-target="confirmButton"
        data-action="confirm#confirm"
      >
      </button>

    </div>

  </div>
</dialog>